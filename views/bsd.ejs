<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>TrackDechets — Générez vos BSD en 30 secondes</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;500;600;700;800&family=Space+Grotesk:wght@300;400;500;600;700&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">
  <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><rect width='32' height='32' rx='6' fill='%23080e0b'/><path d='M8 8h16v2H8zm0 6h12v2H8zm0 6h8v2H8z' fill='%23b8f04a'/></svg>">
  <link rel="stylesheet" href="/css/theme.css">
  <style>
  /* === TRACKDECHETS SPECIFIC === */
  :root {
    --accent: #b8f04a;
    --accent-dark: #9cd93a;
    --accent-pale: #d4f78a;
    --accent-dim: rgba(184, 240, 74, 0.10);
    --accent-border: rgba(184, 240, 74, 0.20);
    --bg: #080e0b;
    --bg-base: #0b130e;
    --bg-card: #0f1912;
    --text: #eff0ec;
    --text-dim: rgba(239, 240, 236, 0.58);
    --text-ghost: rgba(239, 240, 236, 0.28);
    --border: rgba(255, 255, 255, 0.07);
    --radius: 10px;
    --radius-lg: 16px;
    --radius-pill: 100px;
    --lime: #b8f04a;
  }

  body {
    font-family: 'Space Grotesk', sans-serif;
    background: var(--bg);
    color: var(--text);
    overflow-x: hidden;
  }

  /* Nav */
  .bsd-nav {
    position: fixed; top: 0; left: 0; right: 0; z-index: 100;
    padding: 0 48px; height: 60px; display: flex; align-items: center; justify-content: space-between;
    background: rgba(8, 14, 11, 0.90); backdrop-filter: blur(20px);
    border-bottom: 1px solid var(--border);
  }
  .nav-logo { display: flex; align-items: center; gap: 10px; text-decoration: none; }
  .nav-logo-mark { width: 32px; height: 32px; background: var(--accent); border-radius: 8px; display: flex; align-items: center; justify-content: center; }
  .nav-logo-mark svg { width: 18px; height: 18px; }
  .nav-name { font-family: 'Syne', sans-serif; font-size: 17px; font-weight: 700; color: #fff; }
  .nav-badge { font-size: 11px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: var(--accent); padding: 4px 10px; border: 1px solid var(--accent-border); border-radius: 4px; }
  .nav-links { display: flex; gap: 24px; }
  .nav-link { font-size: 14px; color: var(--text-dim); text-decoration: none; transition: color 0.2s; }
  .nav-link:hover { color: var(--text); }

  /* Hero */
  .bsd-hero {
    padding: 140px 48px 80px;
    max-width: 1100px; margin: 0 auto;
    text-align: center;
  }
  .hero-label { font-family: 'Space Mono', monospace; font-size: 11px; font-weight: 700; letter-spacing: 0.15em; text-transform: uppercase; color: var(--accent); margin-bottom: 20px; display: inline-flex; align-items: center; gap: 8px; background: var(--accent-dim); border: 1px solid var(--accent-border); padding: 6px 14px; border-radius: var(--radius-pill); }
  .hero-title { font-family: 'Syne', sans-serif; font-size: clamp(38px, 6vw, 68px); font-weight: 800; line-height: 1.05; margin-bottom: 20px; }
  .hero-title em { font-style: normal; color: var(--accent); }
  .hero-sub { font-size: 18px; color: var(--text-dim); max-width: 600px; margin: 0 auto 48px; line-height: 1.65; }
  .hero-cta { display: inline-flex; align-items: center; gap: 12px; background: var(--accent); color: #080e0b; font-family: 'Syne', sans-serif; font-size: 16px; font-weight: 800; padding: 16px 36px; border-radius: var(--radius-pill); text-decoration: none; transition: background 0.2s, transform 0.15s; cursor: pointer; border: none; }
  .hero-cta:hover { background: var(--accent-pale); transform: translateY(-2px); }

  /* Steps strip */
  .steps-strip { padding: 0 48px 80px; max-width: 1100px; margin: 0 auto; }
  .steps-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; }
  .step-card { background: var(--bg-card); border: 1px solid var(--border); border-radius: var(--radius-lg); padding: 28px 24px; text-align: center; position: relative; }
  .step-num { font-family: 'Space Mono', monospace; font-size: 11px; font-weight: 700; letter-spacing: 0.1em; color: var(--accent); background: var(--accent-dim); border: 1px solid var(--accent-border); width: 28px; height: 28px; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 16px; }
  .step-title { font-family: 'Syne', sans-serif; font-size: 16px; font-weight: 700; margin-bottom: 8px; }
  .step-desc { font-size: 13px; color: var(--text-dim); line-height: 1.55; }

  /* Scanner section */
  .scanner-section { padding: 0 48px 100px; max-width: 860px; margin: 0 auto; }
  .scanner-card { background: var(--bg-card); border: 1px solid var(--border); border-radius: 20px; overflow: hidden; }

  /* Upload zone */
  .upload-zone { border: 2px dashed rgba(184,240,74,0.25); border-radius: 14px; padding: 56px 40px; text-align: center; cursor: pointer; transition: border-color 0.2s, background 0.2s; position: relative; }
  .upload-zone.drag-over { border-color: var(--accent); background: rgba(184,240,74,0.04); }
  .upload-zone.has-preview { padding: 0; border-style: solid; border-color: var(--accent); }
  .upload-icon { width: 64px; height: 64px; background: var(--accent); border-radius: 16px; display: flex; align-items: center; justify-content: center; margin: 0 auto 20px; }
  .upload-icon svg { width: 28px; height: 28px; }
  .upload-title { font-family: 'Syne', sans-serif; font-size: 20px; font-weight: 700; margin-bottom: 8px; }
  .upload-sub { font-size: 14px; color: var(--text-dim); margin-bottom: 24px; }
  .upload-btn { display: inline-block; background: var(--accent); color: #080e0b; font-family: 'Syne', sans-serif; font-size: 14px; font-weight: 700; padding: 10px 24px; border-radius: 8px; border: none; cursor: pointer; transition: background 0.2s; }
  .upload-btn:hover { background: var(--accent-pale); }
  #photo-input { display: none; }

  .preview-wrap { display: none; position: relative; }
  .preview-wrap.visible { display: block; }
  .preview-img { width: 100%; max-height: 360px; object-fit: cover; display: block; }
  .preview-overlay { position: absolute; inset: 0; background: rgba(0,0,0,0.45); display: flex; align-items: center; justify-content: center; opacity: 0; transition: opacity 0.2s; }
  .preview-wrap:hover .preview-overlay { opacity: 1; }
  .preview-change-btn { background: #fff; color: #080e0b; font-size: 13px; font-weight: 600; padding: 8px 20px; border-radius: 8px; border: none; cursor: pointer; }
  .upload-placeholder.hidden { display: none; }

  /* Generator info */
  .generator-section { padding: 28px 36px; border-top: 1px solid var(--border); background: rgba(0,0,0,0.2); }
  .generator-section h3 { font-family: 'Syne', sans-serif; font-size: 14px; font-weight: 700; margin-bottom: 16px; color: var(--accent); letter-spacing: 0.05em; }
  .gen-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  .gen-field { display: flex; flex-direction: column; gap: 5px; }
  .gen-field label { font-size: 11px; font-weight: 600; color: var(--text-dim); letter-spacing: 0.06em; }
  .gen-field input { background: rgba(255,255,255,0.05); border: 1.5px solid rgba(255,255,255,0.1); border-radius: 8px; padding: 10px 12px; color: var(--text); font-family: 'Space Grotesk', sans-serif; font-size: 14px; outline: none; transition: border-color 0.15s; }
  .gen-field input:focus { border-color: var(--accent); }
  .gen-field input::placeholder { color: rgba(255,255,255,0.2); }

  /* Analyze bar */
  .analyze-bar { display: flex; align-items: center; gap: 16px; padding: 20px 36px; border-top: 1px solid var(--border); background: rgba(184,240,74,0.04); }
  .analyze-btn { display: inline-flex; align-items: center; gap: 10px; background: var(--accent); color: #080e0b; font-family: 'Syne', sans-serif; font-size: 16px; font-weight: 800; padding: 14px 32px; border-radius: 10px; border: none; cursor: pointer; transition: background 0.2s, transform 0.15s; }
  .analyze-btn:hover:not(:disabled) { background: var(--accent-pale); transform: translateY(-1px); }
  .analyze-btn:disabled { opacity: 0.45; cursor: not-allowed; transform: none; }
  .analyze-hint { font-size: 13px; color: var(--text-dim); }

  /* Loading */
  .loading-state { display: none; align-items: center; gap: 16px; padding: 28px 36px; background: rgba(184,240,74,0.06); border-top: 1px solid var(--accent-border); }
  .loading-state.visible { display: flex; }
  .spinner { width: 22px; height: 22px; border: 3px solid rgba(184,240,74,0.2); border-top-color: var(--accent); border-radius: 50%; animation: spin 0.8s linear infinite; flex-shrink: 0; }
  @keyframes spin { to { transform: rotate(360deg); } }
  .loading-text { font-size: 15px; color: var(--text); }
  .loading-step { font-size: 12px; color: var(--text-dim); margin-top: 2px; }

  /* Error */
  .error-state { display: none; padding: 20px 36px; background: rgba(248,113,113,0.1); border-top: 1px solid rgba(248,113,113,0.3); }
  .error-state.visible { display: block; }
  .error-title { font-weight: 700; color: #f87171; font-size: 14px; margin-bottom: 4px; }
  .error-msg { font-size: 13px; color: #fca5a5; }

  /* Results */
  .results-section { display: none; }
  .results-section.visible { display: block; }

  .results-header { display: flex; align-items: flex-start; justify-content: space-between; gap: 20px; padding: 36px 36px 0; }
  .results-title { font-family: 'Syne', sans-serif; font-size: 28px; font-weight: 800; margin-bottom: 6px; }
  .results-desc { font-size: 14px; color: var(--text-dim); max-width: 500px; line-height: 1.6; }
  .confidence-badge { padding: 6px 14px; border-radius: 6px; font-size: 12px; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; flex-shrink: 0; }
  .confidence-badge.high { background: rgba(110,231,160,0.15); color: #6ee7a0; }
  .confidence-badge.medium { background: rgba(251,191,36,0.15); color: #fbbf24; }
  .confidence-badge.low { background: rgba(248,113,113,0.15); color: #f87171; }

  /* Summary row */
  .summary-row { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; padding: 24px 36px 0; }
  .sum-card { background: rgba(184,240,74,0.07); border: 1px solid rgba(184,240,74,0.15); border-radius: var(--radius); padding: 20px; }
  .sum-label { font-family: 'Space Mono', monospace; font-size: 10px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--text-dim); margin-bottom: 8px; }
  .sum-value { font-family: 'Syne', sans-serif; font-size: 28px; font-weight: 800; color: var(--accent); line-height: 1; }
  .sum-sub { font-size: 12px; color: var(--text-dim); margin-top: 4px; }

  /* Materials table */
  .materials-section { padding: 24px 36px 0; }
  .materials-label { font-family: 'Space Mono', monospace; font-size: 11px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--accent); margin-bottom: 12px; }
  .mat-row-header { display: grid; grid-template-columns: 1fr 100px 110px 100px 80px; gap: 12px; padding: 8px 0; border-bottom: 1px solid var(--border); margin-bottom: 4px; }
  .mat-row-header span { font-size: 10px; font-weight: 600; letter-spacing: 0.07em; text-transform: uppercase; color: var(--text-dim); }
  .mat-row { display: grid; grid-template-columns: 1fr 100px 110px 100px 80px; gap: 12px; padding: 14px 0; border-bottom: 1px solid var(--border); align-items: center; }
  .mat-name { font-weight: 600; font-size: 15px; }
  .mat-code { font-family: 'Space Mono', monospace; font-size: 12px; color: var(--accent); }
  .mat-weight { font-variant-numeric: tabular-nums; color: var(--text-dim); }
  .mat-value { font-weight: 700; color: var(--text); }
  .mat-conf { font-size: 12px; color: var(--text-dim); }
  .danger-badge { display: inline-block; font-size: 9px; font-weight: 700; background: rgba(248,113,113,0.2); color: #f87171; padding: 2px 6px; border-radius: 3px; margin-top: 3px; }

  /* BSD Form section */
  .bsd-form-section { padding: 28px 36px 0; }
  .bsd-form-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 20px; }
  .bsd-form-title { font-family: 'Syne', sans-serif; font-size: 22px; font-weight: 800; }
  .bsd-actions { display: flex; gap: 10px; }
  .bsd-btn-primary { display: inline-flex; align-items: center; gap: 8px; background: var(--accent); color: #080e0b; font-family: 'Syne', sans-serif; font-size: 14px; font-weight: 700; padding: 12px 24px; border-radius: 8px; border: none; cursor: pointer; text-decoration: none; transition: background 0.2s; }
  .bsd-btn-primary:hover { background: var(--accent-pale); }
  .bsd-btn-secondary { display: inline-flex; align-items: center; gap: 8px; background: transparent; color: var(--text); font-family: 'Syne', sans-serif; font-size: 14px; font-weight: 600; padding: 12px 20px; border-radius: 8px; border: 1.5px solid var(--border); cursor: pointer; transition: border-color 0.2s; }
  .bsd-btn-secondary:hover { border-color: rgba(255,255,255,0.2); }

  /* BSD form fields */
  .bsd-form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .bsd-field-group { background: var(--bg-base); border: 1px solid var(--border); border-radius: var(--radius); padding: 16px 20px; }
  .bsd-group-label { font-size: 11px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--accent); margin-bottom: 12px; }
  .bsd-field-row { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 10px; }
  .bsd-field-row:last-child { margin-bottom: 0; }
  .bsd-field { display: flex; flex-direction: column; gap: 4px; }
  .bsd-field label { font-size: 11px; color: var(--text-dim); }
  .bsd-field input, .bsd-field textarea { background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.1); border-radius: 6px; padding: 8px 10px; color: var(--text); font-family: 'Space Grotesk', sans-serif; font-size: 13px; outline: none; width: 100%; }
  .bsd-field input:focus, .bsd-field textarea:focus { border-color: var(--accent); }
  .bsd-field textarea { resize: vertical; min-height: 60px; }
  .bsd-full { grid-column: 1 / -1; }

  /* Mentions */
  .mentions-row { display: flex; gap: 24px; padding: 16px 20px; background: rgba(184,240,74,0.04); border-top: 1px solid var(--accent-border); margin-top: 0; }
  .mention-check { display: flex; align-items: center; gap: 8px; font-size: 12px; color: var(--text-dim); }
  .mention-check input[type="checkbox"] { width: 16px; height: 16px; accent-color: var(--accent); }
  .mention-check.danger { color: #f87171; }
  .mention-check.danger input[type="checkbox"] { accent-color: #f87171; }

  /* Footer actions */
  .results-footer { padding: 24px 36px 36px; display: flex; align-items: center; gap: 12px; border-top: 1px solid var(--border); }
  .footer-note { font-size: 12px; color: var(--text-ghost); flex: 1; }

  /* Marquee */
  .marquee-strip { background: var(--accent); padding: 10px 0; overflow: hidden; white-space: nowrap; }
  .marquee-content { display: inline-flex; animation: marquee 30s linear infinite; font-family: 'Space Mono', monospace; font-size: 12px; font-weight: 700; color: #080e0b; letter-spacing: 0.05em; }
  @keyframes marquee { 0% { transform: translateX(0); } 100% { transform: translateX(-50%); } }

  @media (max-width: 768px) {
    .bsd-nav { padding: 0 24px; }
    .bsd-hero { padding: 120px 24px 60px; }
    .steps-grid { grid-template-columns: 1fr 1fr; }
    .scanner-section { padding: 0 24px 80px; }
    .gen-grid { grid-template-columns: 1fr; }
    .bsd-form-grid { grid-template-columns: 1fr; }
    .mat-row, .mat-row-header { grid-template-columns: 1fr 90px 80px; }
    .mat-row-header span:nth-child(3),
    .mat-row-header span:nth-child(5),
    .mat-code, .mat-conf { display: none; }
    .summary-row { grid-template-columns: 1fr; }
    .results-header { flex-direction: column; }
  }
  </style>
</head>
<body>

<!-- Nav -->
<nav class="bsd-nav">
  <a href="/" class="nav-logo">
    <div class="nav-logo-mark">
      <svg viewBox="0 0 24 24" fill="none" stroke="#080e0b" stroke-width="2.5">
        <path d="M9 12h6m-3-3v6M5 3h14a2 2 0 012 2v14a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2z"/>
      </svg>
    </div>
    <span class="nav-name">TrackDechets</span>
  </a>
  <div class="nav-links">
    <a href="#scanner" class="nav-link">Scanner</a>
    <a href="#comment-ca-marche" class="nav-link">Comment ca marche</a>
    <a href="https://wastetide.ai" class="nav-link">Par Wastetide</a>
  </div>
  <span class="nav-badge">Beta</span>
</nav>

<!-- Marquee -->
<div class="marquee-strip">
  <div class="marquee-content">
    BSD FRANCAIS &nbsp;&nbsp;•&nbsp;&nbsp; TRACEABILITE DECHETS &nbsp;&nbsp;•&nbsp;&nbsp; AI WASTE IDENTIFICATION &nbsp;&nbsp;•&nbsp;&nbsp; GENERATION AUTOMATIQUE &nbsp;&nbsp;•&nbsp;&nbsp; Bordereau de Suivi des Dechets &nbsp;&nbsp;•&nbsp;&nbsp; DECHEts Dangereux &nbsp;&nbsp;•&nbsp;&nbsp;
    BSD FRANCAIS &nbsp;&nbsp;•&nbsp;&nbsp; TRACEABILITE DECHETS &nbsp;&nbsp;•&nbsp;&nbsp; AI WASTE IDENTIFICATION &nbsp;&nbsp;•&nbsp;&nbsp; GENERATION AUTOMATIQUE &nbsp;&nbsp;•&nbsp;&nbsp; Bordereau de Suivi des Dechets &nbsp;&nbsp;•&nbsp;&nbsp; DECHEts Dangereux &nbsp;&nbsp;•&nbsp;&nbsp;
  </div>
</div>

<!-- Hero -->
<section class="bsd-hero" id="top">
  <div class="hero-label">⚡ Formulaire BSD automatique</div>
  <h1 class="hero-title">Générez vos BSD<br>en <em>30 secondes</em></h1>
  <p class="hero-sub">Scannez vos déchets industriels par photo. L'IA identifie les matériaux, attribue le code déchet officiel, et pré-remplit votre BSD français — prêt à signer et télécharger.</p>
  <a href="#scanner" class="hero-cta">
    <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M23 19a2 2 0 01-2 2H3a2 2 0 01-2-2V8a2 2 0 012-2h4l2-3h6l2 3h4a2 2 0 012 2z"/><circle cx="12" cy="13" r="4"/></svg>
    Scanner mes déchets
  </a>
</section>

<!-- Steps -->
<section class="steps-strip" id="comment-ca-marche">
  <div class="steps-grid">
    <div class="step-card">
      <div class="step-num">01</div>
      <div class="step-title">Upload photo</div>
      <div class="step-desc">Deposez une photo de vos déchets.JPG, PNG, WEBP jusqu'a 20MB.</div>
    </div>
    <div class="step-card">
      <div class="step-num">02</div>
      <div class="step-title">IA identifie</div>
      <div class="step-desc">GPT-4o vision detecte les materiaux: cuivre, aluminium, plastiques, etc.</div>
    </div>
    <div class="step-card">
      <div class="step-num">03</div>
      <div class="step-title">Code déchet</div>
      <div class="step-desc">Attribution automatique du code officiel selon le Catalogue Europeen des Dechets.</div>
    </div>
    <div class="step-card">
      <div class="step-num">04</div>
      <div class="step-title">BSD PDF</div>
      <div class="step-desc">Telechargez votre BSD pre-rempli, signe et pret pour TrackDechets.</div>
    </div>
  </div>
</section>

<!-- Scanner -->
<section class="scanner-section" id="scanner">
  <div class="scanner-card">

    <!-- Upload zone -->
    <div class="upload-zone" id="upload-zone">
      <div class="upload-placeholder" id="upload-placeholder">
        <div class="upload-icon">
          <svg fill="none" stroke="#080e0b" stroke-width="2.5" viewBox="0 0 24 24">
            <path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4M17 8l-5-5-5 5M12 3v12"/>
          </svg>
        </div>
        <div class="upload-title">Deposez votre photo de déchets</div>
        <div class="upload-sub">PNG, JPG, WEBP jusqu'a 20MB · Ou cliquez pour parcourir</div>
        <button class="upload-btn" onclick="document.getElementById('photo-input').click()">Choisir une photo</button>
        <input type="file" id="photo-input" accept="image/*">
      </div>
      <div class="preview-wrap" id="preview-wrap">
        <img id="preview-img" class="preview-img" src="" alt="Apercu de la photo">
        <div class="preview-overlay">
          <button class="preview-change-btn" onclick="document.getElementById('photo-input').click()">Changer la photo</button>
        </div>
      </div>
    </div>

    <!-- Generator info -->
    <div class="generator-section">
      <h3>Informations producteur (optionnel)</h3>
      <div class="gen-grid">
        <div class="gen-field">
          <label>Nom / Raison sociale</label>
          <input type="text" id="gen-name" placeholder="Acme Industries" autocomplete="organization">
        </div>
        <div class="gen-field">
          <label>SIRET</label>
          <input type="text" id="gen-siret" placeholder="123 456 789 00012" maxlength="14">
        </div>
        <div class="gen-field">
          <label>Adresse</label>
          <input type="text" id="gen-address" placeholder="Zone Industrielle, 69001 Lyon" autocomplete="street-address">
        </div>
        <div class="gen-field">
          <label>Telephone</label>
          <input type="tel" id="gen-phone" placeholder="+33 1 23 45 67 89" autocomplete="tel">
        </div>
      </div>
    </div>

    <!-- Analyze bar -->
    <div class="analyze-bar">
      <button class="analyze-btn" id="analyze-btn" disabled onclick="runScan()">
        <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
        Analyser et générer le BSD
      </button>
      <span class="analyze-hint" id="analyze-hint">Uploadez une photo pour commencer</span>
    </div>

    <!-- Loading -->
    <div class="loading-state" id="loading-state">
      <div class="spinner"></div>
      <div>
        <div class="loading-text" id="loading-text">Upload en cours...</div>
        <div class="loading-step" id="loading-step">Envoi vers le stockage securise</div>
      </div>
    </div>

    <!-- Error -->
    <div class="error-state" id="error-state">
      <div class="error-title">Erreur d'analyse</div>
      <div class="error-msg" id="error-msg"></div>
    </div>

    <!-- Results -->
    <div class="results-section" id="results-section">

      <div class="results-header">
        <div>
          <div class="results-title">Analyse terminee</div>
          <div class="results-desc" id="scene-description"></div>
        </div>
        <span class="confidence-badge" id="confidence-badge"></span>
      </div>

      <!-- Summary cards -->
      <div class="summary-row">
        <div class="sum-card">
          <div class="sum-label">Poids total identifie</div>
          <div class="sum-value" id="total-weight">—</div>
          <div class="sum-sub">kg de materiaux</div>
        </div>
        <div class="sum-card">
          <div class="sum-label">Code Dechet principal</div>
          <div class="sum-value" id="primary-code" style="font-size:20px;">—</div>
          <div class="sum-sub" id="primary-code-label"></div>
        </div>
        <div class="sum-card">
          <div class="sum-label">Nombre de materiaux</div>
          <div class="sum-value" id="material-count">—</div>
          <div class="sum-sub">types detectes</div>
        </div>
      </div>

      <!-- Materials table -->
      <div class="materials-section">
        <div class="materials-label">Materiaux detectes</div>
        <div class="mat-row-header">
          <span>Materiau</span>
          <span>Code Dechet</span>
          <span>Poids</span>
          <span>Confiance</span>
          <span></span>
        </div>
        <div id="materials-list"></div>
      </div>

      <!-- BSD Form -->
      <div class="bsd-form-section">
        <div class="bsd-form-header">
          <div class="bsd-form-title">Formulaire BSD pre-rempli</div>
          <div class="bsd-actions">
            <button class="bsd-btn-secondary" onclick="window.open('/api/bsd/' + currentScanId + '/pdf', '_blank')">
              <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M6 2h9l5 5v13a2 2 0 01-2 2H6a2 2 0 01-2-2V4a2 2 0 012-2z"/><path d="M14 2v6h6M8 13h8M8 17h5"/></svg>
              Voir PDF
            </button>
            <button class="bsd-btn-primary" onclick="downloadBsdPdf()">
              <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4M7 10l5 5 5-5M12 15V3"/></svg>
              Telecharger BSD
            </button>
          </div>
        </div>

        <div class="bsd-form-grid">
          <div class="bsd-field-group">
            <div class="bsd-group-label">1. Producteur / Detenteur</div>
            <div class="bsd-field-row">
              <div class="bsd-field">
                <label>Nom</label>
                <input type="text" id="bsd-prod-name" placeholder="Acme Industries">
              </div>
              <div class="bsd-field">
                <label>SIRET</label>
                <input type="text" id="bsd-prod-siret" placeholder="12345678901234">
              </div>
            </div>
            <div class="bsd-field-row">
              <div class="bsd-field">
                <label>Adresse</label>
                <input type="text" id="bsd-prod-address" placeholder="ZI, 69001 Lyon">
              </div>
              <div class="bsd-field">
                <label>Telephone</label>
                <input type="text" id="bsd-prod-phone" placeholder="+33 1 23 45 67 89">
              </div>
            </div>
          </div>

          <div class="bsd-field-group">
            <div class="bsd-group-label">2. Nature des dechets</div>
            <div class="bsd-field-row">
              <div class="bsd-field">
                <label>Code Dechet (CED)</label>
                <input type="text" id="bsd-waste-code" placeholder="17 04 07">
              </div>
              <div class="bsd-field">
                <label>Poids total (kg)</label>
                <input type="text" id="bsd-weight" placeholder="25.5">
              </div>
            </div>
            <div class="bsd-field-row">
              <div class="bsd-field bsd-full">
                <label>Description / Observations</label>
                <input type="text" id="bsd-nature" placeholder="Melange de cuivre et aluminium, cables et tuyaux">
              </div>
            </div>
          </div>

          <div class="bsd-field-group">
            <div class="bsd-group-label">3. Transporteur (a remplir)</div>
            <div class="bsd-field-row">
              <div class="bsd-field">
                <label>Nom transporteur</label>
                <input type="text" id="bsd-trans-name" placeholder="Transport Dupont">
              </div>
              <div class="bsd-field">
                <label>N° Immatriculation</label>
                <input type="text" id="bsd-trans-reg" placeholder="AB-123-CD">
              </div>
            </div>
            <div class="bsd-field-row">
              <div class="bsd-field">
                <label>Nom du conducteur</label>
                <input type="text" id="bsd-trans-driver" placeholder="Jean Martin">
              </div>
              <div class="bsd-field">
                <label>Date depart</label>
                <input type="text" id="bsd-trans-date" placeholder="08/06/2026">
              </div>
            </div>
          </div>

          <div class="bsd-field-group">
            <div class="bsd-group-label">4. Installation de destination (a remplir)</div>
            <div class="bsd-field-row">
              <div class="bsd-field">
                <label>Nom installateur</label>
                <input type="text" id="bsd-inst-name" placeholder="Centrale de traitement X">
              </div>
              <div class="bsd-field">
                <label>N° SIRET</label>
                <input type="text" id="bsd-inst-siret" placeholder="98765432109876">
              </div>
            </div>
            <div class="bsd-field-row">
              <div class="bsd-field bsd-full">
                <label>Adresse</label>
                <input type="text" id="bsd-inst-address" placeholder="Zone industrielle, 69002 Lyon">
              </div>
            </div>
          </div>
        </div>

        <!-- Mentions -->
        <div class="mentions-row">
          <label class="mention-check">
            <input type="checkbox" id="mention-sign" checked>
            Le BSD est signe par le producteur
          </label>
          <label class="mention-check" id="mention-danger-wrap" style="display:none;">
            <input type="checkbox" id="mention-danger">
            Dechets dangereux — handling conforme a l'arrete
          </label>
        </div>

        <!-- Lead capture — optional, after the BSD is already usable -->
        <div style="padding: 24px 36px 0;">
          <form class="bsd-field-group" id="bsd-lead-form" onsubmit="submitBsdLead(event)">
            <div class="bsd-group-label">Valoriser ces dechets</div>
            <p style="font-size: 13px; color: var(--text-dim); line-height: 1.55; margin-bottom: 12px;">Une partie de ces dechets a une valeur de revente. Laissez votre email : l'equipe Wastetide vous recontacte avec une estimation.</p>
            <div class="bsd-field-row">
              <div class="bsd-field">
                <label for="bsd-lead-name">Nom</label>
                <input type="text" id="bsd-lead-name" placeholder="Marie Dupont" autocomplete="name">
              </div>
              <div class="bsd-field">
                <label for="bsd-lead-email">Email professionnel *</label>
                <input type="email" id="bsd-lead-email" placeholder="marie@acme.fr" autocomplete="email" required>
              </div>
            </div>
            <div style="display: flex; align-items: center; gap: 12px; margin-top: 12px;">
              <button type="submit" class="bsd-btn-primary" id="bsd-lead-btn">Etre recontacte</button>
              <span class="footer-note" id="bsd-lead-status" aria-live="polite"></span>
            </div>
          </form>
        </div>

        <div class="results-footer">
          <span class="footer-note">Document genere automatiquement — a verifier et signer avant depot sur TrackDechets officiel.</span>
          <button class="bsd-btn-secondary" onclick="resetScanner()">
            <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M1 4v6h6M23 20v-6h-6"/><path d="M20.49 9A9 9 0 005.64 5.64L1 10m22 4l-4.64 4.36A9 9 0 013.51 15"/></svg>
            Nouveau scan
          </button>
        </div>
      </div>

    </div><!-- /results-section -->
  </div><!-- /scanner-card -->
</section>

<script>
  const uploadZone = document.getElementById('upload-zone');
  const uploadPlaceholder = document.getElementById('upload-placeholder');
  const previewWrap = document.getElementById('preview-wrap');
  const previewImg = document.getElementById('preview-img');
  const photoInput = document.getElementById('photo-input');
  const analyzeBtn = document.getElementById('analyze-btn');
  const analyzeHint = document.getElementById('analyze-hint');
  const loadingState = document.getElementById('loading-state');
  const loadingText = document.getElementById('loading-text');
  const loadingStep = document.getElementById('loading-step');
  const errorState = document.getElementById('error-state');
  const errorMsg = document.getElementById('error-msg');
  const resultsSection = document.getElementById('results-section');

  let selectedFile = null;
  let currentScanId = null;
  let lastBsdData = null;

  // Drag & drop
  uploadZone.addEventListener('dragover', (e) => { e.preventDefault(); uploadZone.classList.add('drag-over'); });
  uploadZone.addEventListener('dragleave', () => uploadZone.classList.remove('drag-over'));
  uploadZone.addEventListener('drop', (e) => {
    e.preventDefault(); uploadZone.classList.remove('drag-over');
    const file = e.dataTransfer.files[0];
    if (file && file.type.startsWith('image/')) setFile(file);
  });
  uploadZone.addEventListener('click', (e) => {
    if (e.target.closest('.preview-overlay')) return;
    if (!uploadZone.classList.contains('has-preview')) photoInput.click();
  });
  photoInput.addEventListener('change', () => { if (photoInput.files[0]) setFile(photoInput.files[0]); });

  function setFile(file) {
    selectedFile = file;
    previewImg.src = URL.createObjectURL(file);
    uploadPlaceholder.classList.add('hidden');
    previewWrap.classList.add('visible');
    uploadZone.classList.add('has-preview');
    analyzeBtn.disabled = false;
    analyzeHint.textContent = file.name + ' — Cliquez Analyser pour continuer';
    hideResults(); hideError();
  }

  function hideResults() { resultsSection.classList.remove('visible'); }
  function hideError() { errorState.classList.remove('visible'); }

  function showError(msg) {
    errorMsg.textContent = msg;
    errorState.classList.add('visible');
    loadingState.classList.remove('visible');
  }

  function setLoading(step) {
    loadingState.classList.add('visible');
    const steps = {
      upload: { text: 'Upload en cours...', sub: 'Envoi vers le stockage securise' },
      analyze: { text: 'Analyse en cours...', sub: 'GPT-4o vision — identification des materiaux' },
      bsd: { text: 'Generation BSD...', sub: 'Calcul du code dechet et pre-remplissage du formulaire' },
    };
    const s = steps[step] || steps.upload;
    loadingText.textContent = s.text;
    loadingStep.textContent = s.sub;
  }

  async function runScan() {
    if (!selectedFile) return;
    analyzeBtn.disabled = true;
    hideError(); hideResults();
    setLoading('upload');

    const stepTimer1 = setTimeout(() => setLoading('analyze'), 1200);
    const stepTimer2 = setTimeout(() => setLoading('bsd'), 5000);

    try {
      const formData = new FormData();
      formData.append('photo', selectedFile);
      formData.append('generator_name', document.getElementById('gen-name').value.trim());
      formData.append('generator_address', document.getElementById('gen-address').value.trim());
      formData.append('generator_phone', document.getElementById('gen-phone').value.trim());
      formData.append('generator_siret', document.getElementById('gen-siret').value.trim());

      const res = await fetch('/api/bsd/scan', { method: 'POST', body: formData });
      clearTimeout(stepTimer1); clearTimeout(stepTimer2);

      const data = await res.json();
      if (!res.ok || !data.success) throw new Error(data.error || 'Analyse echouee');

      currentScanId = data.scan_id;
      lastBsdData = data;
      renderResults(data);
    } catch (err) {
      clearTimeout(stepTimer1); clearTimeout(stepTimer2);
      showError(err.message);
    } finally {
      loadingState.classList.remove('visible');
      analyzeBtn.disabled = false;
    }
  }

  function fmt(n) {
    return new Intl.NumberFormat('fr-FR', { maximumFractionDigits: 1 }).format(n);
  }

  function renderResults(data) {
    const { materials, scene_description, confidence, total_weight_kg, primary_waste_code } = data;

    // Header
    document.getElementById('scene-description').textContent = scene_description || '';
    const badge = document.getElementById('confidence-badge');
    const confMap = { high: 'Haute confiance', medium: 'Confiance moyenne', low: 'Confiance faible' };
    badge.textContent = confMap[confidence] || confidence;
    badge.className = 'confidence-badge ' + (confidence || 'medium');

    // Summary
    document.getElementById('total-weight').textContent = fmt(total_weight_kg) + ' kg';
    document.getElementById('primary-code').textContent = primary_waste_code?.code || '—';
    document.getElementById('primary-code-label').textContent = primary_waste_code?.label || '';
    document.getElementById('material-count').textContent = (materials || []).length;

    // Materials list
    const list = document.getElementById('materials-list');
    list.innerHTML = '';
    (materials || []).forEach((m) => {
      const row = document.createElement('div');
      row.className = 'mat-row';
      row.innerHTML = `
        <div>
          <div class="mat-name">${escHtml(m.label || m.material_key)}</div>
          ${m.danger ? '<div class="danger-badge">DANGEREUX</div>' : ''}
        </div>
        <div class="mat-code">${escHtml(m.waste_code)}</div>
        <div class="mat-weight">${fmt(m.weight_kg)} kg</div>
        <div class="mat-conf">${m.confidence_pct}%</div>
        <div></div>
      `;
      list.appendChild(row);
    });

    // Pre-fill BSD form
    const gen = {
      name: document.getElementById('gen-name').value,
      address: document.getElementById('gen-address').value,
      phone: document.getElementById('gen-phone').value,
      siret: document.getElementById('gen-siret').value,
    };

    document.getElementById('bsd-prod-name').value = gen.name;
    document.getElementById('bsd-prod-siret').value = gen.siret;
    document.getElementById('bsd-prod-address').value = gen.address;
    document.getElementById('bsd-prod-phone').value = gen.phone;
    document.getElementById('bsd-waste-code').value = primary_waste_code?.code || '';
    document.getElementById('bsd-weight').value = fmt(total_weight_kg);

    const natureStr = (materials || []).map(m => m.label || m.material_key).join(', ');
    document.getElementById('bsd-nature').value = natureStr;
    document.getElementById('bsd-trans-date').value = new Date().toLocaleDateString('fr-FR');

    // Danger mentions
    const dangerWrap = document.getElementById('mention-danger-wrap');
    const hasDanger = (materials || []).some(m => m.danger);
    if (hasDanger) {
      dangerWrap.style.display = 'flex';
      document.getElementById('mention-danger').checked = true;
    } else {
      dangerWrap.style.display = 'none';
    }

    resultsSection.classList.add('visible');
    resultsSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  function downloadBsdPdf() {
    if (!currentScanId) return;
    const win = window.open('/api/bsd/' + currentScanId + '/pdf', '_blank');
    // Auto-trigger print dialog so user can Save as PDF
    win.onload = () => { setTimeout(() => win.print(), 500); };
  }

  async function submitBsdLead(e) {
    e.preventDefault();
    const btn = document.getElementById('bsd-lead-btn');
    const status = document.getElementById('bsd-lead-status');
    const email = document.getElementById('bsd-lead-email').value.trim();
    const company = document.getElementById('bsd-prod-name').value.trim();
    const name = document.getElementById('bsd-lead-name').value.trim() || company || email;
    if (!email.includes('@')) { status.textContent = 'Email invalide.'; return; }

    btn.disabled = true;
    status.textContent = 'Envoi...';
    try {
      const res = await fetch('/api/leads', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          name, email, company,
          scan_data: { bsd_scan_id: currentScanId, materials: lastBsdData?.materials || [] },
          source: 'bsd',
        }),
      });
      const result = await res.json();
      if (!res.ok || !result.success) throw new Error(result.error || 'Echec');
      status.textContent = 'Merci, on vous recontacte.';
    } catch (err) {
      btn.disabled = false;
      status.textContent = 'Echec de l\'envoi, reessayez.';
    }
  }

  function resetScanner() {
    selectedFile = null;
    photoInput.value = '';
    previewImg.src = '';
    uploadPlaceholder.classList.remove('hidden');
    previewWrap.classList.remove('visible');
    uploadZone.classList.remove('has-preview');
    analyzeBtn.disabled = true;
    analyzeHint.textContent = 'Uploadez une photo pour commencer';
    hideResults(); hideError();
    currentScanId = null;
    lastBsdData = null;
    document.getElementById('bsd-lead-form').reset();
    document.getElementById('bsd-lead-btn').disabled = false;
    document.getElementById('bsd-lead-status').textContent = '';
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }

  function escHtml(str) {
    return String(str || '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
  }
</script>

</body>
</html>