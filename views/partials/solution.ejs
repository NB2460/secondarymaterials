<!-- Solution section — owns the product pitch and scan-card mockup. Does NOT own feature details. -->
<section class="solution" id="solution">
  <div class="solution-inner">
    <div class="solution-text">
      <p class="label">The solution</p>
      <h2 class="solution-headline">We see what you throw away.<br>And we tell you what it's worth.</h2>
      <p class="solution-body">Our AI analyzes a photo of your waste and instantly identifies the materials inside, estimates their resale value based on live commodity prices, and quantifies the CO₂ emissions avoided by recycling rather than landfilling.</p>
      <p class="solution-body">Waste should be a solution, not a cost centre. We help you turn yours into one.</p>
    </div>
