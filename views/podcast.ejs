<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Secondary Materials — Podcast by WastetideOS</title>
  <meta name="description" content="Conversations with the leaders building the circular economy. A podcast on industrial waste, end-of-life equipment, and the future of material recovery.">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;500;600;700;800&family=Space+Grotesk:wght@300;400;500;600;700&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">
  <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><rect width='32' height='32' rx='6' fill='%23080e0b'/><path d='M8 22 L8 14 Q8 10 12 10 L12 22' stroke='%23b8f04a' stroke-width='2.5' fill='none' stroke-linecap='round'/><path d='M15 22 L15 12 Q15 8 19 8 L19 22' stroke='%23b8f04a' stroke-width='2.5' fill='none' stroke-linecap='round'/><path d='M22 22 L22 15 Q22 11 26 11 L26 22' stroke='%23b8f04a' stroke-width='2.5' fill='none' stroke-linecap='round'/></svg>">
  <link rel="stylesheet" href="/css/theme.css">
  <style>
  :root {
    --accent: #b8f04a;
    --accent-dark: #9cd93a;
    --accent-pale: #d4f78a;
    --accent-dim: rgba(184, 240, 74, 0.08);
    --accent-border: rgba(184, 240, 74, 0.20);
    --bg: #080e0b;
    --bg-base: #0b130e;
    --bg-card: #0f1912;
    --bg-mid: #142019;
    --text: #eff0ec;
    --text-dim: rgba(239, 240, 236, 0.58);
    --text-ghost: rgba(239, 240, 236, 0.28);
    --border: rgba(255, 255, 255, 0.07);
    --radius: 10px;
    --radius-lg: 16px;
    --radius-pill: 100px;
    --lime: #b8f04a;
  }

  body {
    font-family: 'Space Grotesk', sans-serif;
    background: var(--bg);
    color: var(--text);
    overflow-x: hidden;
    -webkit-font-smoothing: antialiased;
  }

  /* ── Nav ───────────────────────────────────────────────────────────── */
  .podcast-nav {
    position: fixed; top: 0; left: 0; right: 0; z-index: 100;
    padding: 0 48px; height: 60px; display: flex; align-items: center; justify-content: space-between;
    background: rgba(8, 14, 11, 0.92); backdrop-filter: blur(20px);
    border-bottom: 1px solid var(--border);
  }
  .podcast-nav-logo {
    display: flex; align-items: center; gap: 10px; text-decoration: none;
  }
  .podcast-nav-logo-mark {
    width: 32px; height: 32px; background: var(--accent); border-radius: 8px;
    display: flex; align-items: center; justify-content: center;
  }
  .podcast-nav-logo-mark svg { width: 18px; height: 18px; }
  .podcast-nav-name {
    font-family: 'Syne', sans-serif; font-size: 17px; font-weight: 700; color: #fff;
  }
  .podcast-nav-badge {
    font-size: 11px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase;
    color: var(--accent); padding: 4px 10px;
    border: 1px solid var(--accent-border); border-radius: 4px;
  }
  .podcast-nav-links { display: flex; gap: 24px; }
  .podcast-nav-link { font-size: 14px; color: var(--text-dim); text-decoration: none; transition: color 0.2s; }
  .podcast-nav-link:hover { color: var(--text); }
  .podcast-nav-cta {
    font-size: 14px; font-weight: 600; color: var(--bg); text-decoration: none;
    background: var(--accent); padding: 8px 18px; border-radius: var(--radius-pill);
    transition: background 0.2s;
  }
  .podcast-nav-cta:hover { background: var(--accent-dark); }

  /* ── Hero ───────────────────────────────────────────────────────────── */
  .podcast-hero {
    position: relative; overflow: hidden;
    padding: 160px 48px 80px;
    text-align: center;
  }
  .podcast-hero-bg {
    position: absolute; inset: 0; z-index: 0;
  }
  .podcast-hero-bg img {
    width: 100%; height: 100%; object-fit: cover; opacity: 0.25;
    filter: grayscale(60%);
  }
  .podcast-hero-bg::after {
    content: ''; position: absolute; inset: 0;
    background: linear-gradient(to bottom, rgba(8,14,11,0.6) 0%, rgba(8,14,11,0.95) 80%, var(--bg) 100%);
  }
  .podcast-hero-content { position: relative; z-index: 1; max-width: 860px; margin: 0 auto; }
  .podcast-hero-label {
    display: inline-block;
    font-family: 'Space Mono', monospace; font-size: 12px; letter-spacing: 0.12em;
    text-transform: uppercase; color: var(--accent); margin-bottom: 28px;
    padding: 6px 14px; border: 1px solid var(--accent-border); border-radius: 4px;
  }
  .podcast-hero h1 {
    font-family: 'Syne', sans-serif; font-size: clamp(48px, 7vw, 88px); font-weight: 800;
    line-height: 0.95; letter-spacing: -0.03em; color: #fff; margin-bottom: 20px;
  }
  .podcast-hero h1 span { color: var(--accent); }
  .podcast-hero-tagline {
    font-size: 18px; color: var(--text-dim); max-width: 560px; margin: 0 auto 12px;
    line-height: 1.6;
  }
  .podcast-hero-host {
    font-size: 13px; color: var(--text-ghost); font-family: 'Space Mono', monospace;
    margin-bottom: 36px;
  }
  .podcast-hero-host span { color: var(--text-dim); }
  .podcast-hero-btns { display: flex; gap: 14px; justify-content: center; flex-wrap: wrap; }
  .btn-primary {
    display: inline-flex; align-items: center; gap: 8px;
    font-family: 'Space Grotesk', sans-serif; font-size: 15px; font-weight: 600;
    color: var(--bg); background: var(--accent); padding: 12px 26px;
    border-radius: var(--radius-pill); text-decoration: none; transition: background 0.2s;
  }
  .btn-primary:hover { background: var(--accent-dark); }
  .btn-secondary {
    display: inline-flex; align-items: center; gap: 8px;
    font-family: 'Space Grotesk', sans-serif; font-size: 15px; font-weight: 500;
    color: var(--text); background: transparent; padding: 12px 26px;
    border: 1px solid var(--border); border-radius: var(--radius-pill);
    text-decoration: none; transition: border-color 0.2s, color 0.2s;
  }
  .btn-secondary:hover { border-color: var(--accent-border); color: var(--accent); }

  /* ── Episodes ──────────────────────────────────────────────────────── */
  .podcast-section { padding: 80px 48px; max-width: 1100px; margin: 0 auto; }
  .podcast-section-label {
    font-family: 'Space Mono', monospace; font-size: 11px; letter-spacing: 0.14em;
    text-transform: uppercase; color: var(--accent); margin-bottom: 14px;
  }
  .podcast-section h2 {
    font-family: 'Syne', sans-serif; font-size: clamp(32px, 4vw, 48px); font-weight: 700;
    color: #fff; margin-bottom: 40px;
  }
  .episodes-grid {
    display: grid; grid-template-columns: repeat(auto-fill, minmax(340px, 1fr)); gap: 24px;
  }
  .episode-card {
    background: var(--bg-card); border: 1px solid var(--border);
    border-radius: var(--radius-lg); overflow: hidden;
    transition: border-color 0.2s, transform 0.2s;
  }
  .episode-card:hover { border-color: var(--accent-border); transform: translateY(-2px); }
  .episode-thumbnail {
    width: 100%; aspect-ratio: 16/9; object-fit: cover;
    background: var(--bg-mid);
  }
  .episode-card-body { padding: 24px; }
  .episode-meta {
    display: flex; align-items: center; gap: 16px; margin-bottom: 14px;
  }
  .episode-badge {
    font-family: 'Space Mono', monospace; font-size: 11px; letter-spacing: 0.1em;
    color: var(--accent); padding: 4px 10px;
    border: 1px solid var(--accent-border); border-radius: 4px; flex-shrink: 0;
  }
  .episode-duration {
    font-family: 'Space Mono', monospace; font-size: 11px; color: var(--text-ghost);
  }
  .episode-guest {
    font-size: 12px; color: var(--text-ghost); margin-bottom: 6px;
  }
  .episode-guest strong { color: var(--text-dim); }
  .episode-title {
    font-family: 'Syne', sans-serif; font-size: 18px; font-weight: 700; color: #fff;
    margin-bottom: 10px; line-height: 1.3;
  }
  .episode-description {
    font-size: 14px; color: var(--text-dim); line-height: 1.6;
    margin-bottom: 20px;
    display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;
  }
  .episode-actions { display: flex; gap: 10px; }
  .btn-watch {
    display: inline-flex; align-items: center; gap: 6px;
    font-size: 13px; font-weight: 600; color: var(--bg);
    background: var(--accent); padding: 9px 18px;
    border-radius: var(--radius-pill); text-decoration: none; transition: background 0.2s;
  }
  .btn-watch:hover { background: var(--accent-dark); }
  .btn-watch.disabled {
    background: var(--bg-mid); color: var(--text-ghost);
    pointer-events: none; cursor: default;
  }
  .empty-episodes {
    grid-column: 1/-1; text-align: center; padding: 64px 24px;
    border: 1px dashed var(--border); border-radius: var(--radius-lg);
    color: var(--text-dim); font-size: 15px;
  }
  .empty-episodes p { margin-top: 10px; font-size: 13px; color: var(--text-ghost); }

  /* ── Guest Application ─────────────────────────────────────────────── */
  .apply-section { background: var(--bg-card); border: 1px solid var(--border); border-radius: var(--radius-lg); padding: 64px 48px; }
  .apply-header { max-width: 560px; }
  .apply-form { max-width: 560px; margin-top: 36px; }
  .form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .form-field { display: flex; flex-direction: column; gap: 6px; }
  .form-field.full { grid-column: 1/-1; }
  .form-label { font-size: 12px; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: var(--text-dim); }
  .form-input, .form-textarea {
    background: var(--bg-base); border: 1px solid var(--border); border-radius: var(--radius);
    padding: 12px 16px; font-family: 'Space Grotesk', sans-serif; font-size: 15px; color: var(--text);
    outline: none; transition: border-color 0.2s;
  }
  .form-input:focus, .form-textarea:focus { border-color: var(--accent-border); }
  .form-input::placeholder, .form-textarea::placeholder { color: var(--text-ghost); }
  .form-textarea { resize: vertical; min-height: 110px; }
  .form-submit {
    margin-top: 8px; background: var(--accent); color: var(--bg);
    font-family: 'Space Grotesk', sans-serif; font-size: 15px; font-weight: 600;
    padding: 14px 32px; border: none; border-radius: var(--radius-pill);
    cursor: pointer; transition: background 0.2s;
  }
  .form-submit:hover { background: var(--accent-dark); }
  .form-submit:disabled { background: var(--bg-mid); color: var(--text-ghost); cursor: not-allowed; }
  .form-success {
    display: none; padding: 20px 24px; border-radius: var(--radius);
    background: var(--accent-dim); border: 1px solid var(--accent-border); color: var(--accent);
    font-size: 15px; margin-top: 16px;
  }
  .form-success.show { display: block; }

  /* ── Email Signup ───────────────────────────────────────────────────── */
  .signup-section { text-align: center; max-width: 560px; margin: 0 auto; }
  .signup-form { display: flex; gap: 12px; margin-top: 28px; flex-wrap: wrap; justify-content: center; }
  .signup-input {
    flex: 1; min-width: 240px; background: var(--bg-base); border: 1px solid var(--border);
    border-radius: var(--radius-pill); padding: 13px 20px;
    font-family: 'Space Grotesk', sans-serif; font-size: 15px; color: var(--text);
    outline: none; transition: border-color 0.2s;
  }
  .signup-input:focus { border-color: var(--accent-border); }
  .signup-input::placeholder { color: var(--text-ghost); }
  .signup-submit {
    background: var(--accent); color: var(--bg);
    font-family: 'Space Grotesk', sans-serif; font-size: 15px; font-weight: 600;
    padding: 13px 28px; border: none; border-radius: var(--radius-pill);
    cursor: pointer; transition: background 0.2s; white-space: nowrap;
  }
  .signup-submit:hover { background: var(--accent-dark); }
  .signup-submit:disabled { background: var(--bg-mid); color: var(--text-ghost); cursor: not-allowed; }
  .signup-success {
    display: none; padding: 14px 20px; border-radius: var(--radius);
    background: var(--accent-dim); border: 1px solid var(--accent-border); color: var(--accent);
    font-size: 14px; margin-top: 14px;
  }
  .signup-success.show { display: block; }

  /* ── Footer ─────────────────────────────────────────────────────────── */
  .podcast-footer { border-top: 1px solid var(--border); margin-top: 80px; }
  .podcast-footer-inner {
    max-width: 1100px; margin: 0 auto; padding: 40px 48px;
    display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 24px;
  }
  .podcast-footer-brand { display: flex; align-items: center; gap: 10px; }
  .podcast-footer-brand svg { width: 28px; height: 28px; }
  .podcast-footer-brand span { font-family: 'Syne', sans-serif; font-size: 16px; font-weight: 700; color: #fff; }
  .podcast-footer-links { display: flex; gap: 24px; }
  .podcast-footer-links a { font-size: 13px; color: var(--text-dim); text-decoration: none; transition: color 0.2s; }
  .podcast-footer-links a:hover { color: var(--text); }
  .podcast-footer-built { font-size: 12px; color: var(--text-ghost); }
  .podcast-footer-built a { color: var(--text-ghost); text-decoration: none; }
  .podcast-footer-built a:hover { color: var(--text-dim); }

  @media (max-width: 640px) {
    .podcast-nav { padding: 0 20px; }
    .podcast-nav-links { display: none; }
    .podcast-hero { padding: 140px 20px 64px; }
    .podcast-section { padding: 60px 20px; }
    .apply-section { padding: 40px 24px; }
    .form-grid { grid-template-columns: 1fr; }
    .podcast-footer-inner { padding: 32px 20px; flex-direction: column; align-items: flex-start; }
  }
  </style>
</head>
<body>

  <!-- Nav -->
  <nav class="podcast-nav">
    <a href="/" class="podcast-nav-logo">
      <div class="podcast-nav-logo-mark">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
          <path d="M4 11 L4 7 Q4 5 6 5 L6 11" stroke="#080e0b" stroke-width="1.5" fill="none" stroke-linecap="round"/>
          <path d="M7.5 11 L7.5 5.5 Q7.5 3.5 9.5 3.5 L9.5 11" stroke="#080e0b" stroke-width="1.5" fill="none" stroke-linecap="round"/>
          <path d="M11 11 L11 8 Q11 6 13 6 L13 11" stroke="#080e0b" stroke-width="1.5" fill="none" stroke-linecap="round"/>
        </svg>
      </div>
      <span class="podcast-nav-name">WastetideOS</span>
    </a>
    <div class="podcast-nav-links">
      <a href="#episodes" class="podcast-nav-link">Episodes</a>
      <a href="#apply" class="podcast-nav-link">Be a Guest</a>
      <a href="#notify" class="podcast-nav-link">Notify Me</a>
    </div>
    <a href="/" class="podcast-nav-cta">WastetideOS</a>
  </nav>

  <!-- Hero -->
  <section class="podcast-hero">
    <div class="podcast-hero-bg">
      <img src="https://pub-629428d185ca4960a0a73c850d32294b.r2.dev/generated-images/company_139569/730922fc-7031-4a9c-ab11-4677fa581438.jpg" alt="Secondary Materials podcast banner" loading="eager">
    </div>
    <div class="podcast-hero-content">
      <span class="podcast-hero-label">Podcast Series</span>
      <h1>Secondary <span>Materials</span></h1>
      <p class="podcast-hero-tagline">Conversations with the leaders building the circular economy.</p>
      <p class="podcast-hero-host">Hosted by <span>Nicolas Brien</span> &mdash; CEO, Wastetide</p>
      <div class="podcast-hero-btns">
        <a href="#episodes" class="btn-primary">
          <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
          Listen to Episodes
        </a>
        <a href="#notify" class="btn-secondary">
          <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M18 8A6 6 0 006 8c0 7-3 9-3 9h18s-3-2-3-9M13.73 21a2 2 0 01-3.46 0"/></svg>
          Get Notified
        </a>
      </div>
    </div>
  </section>

  <!-- Episodes -->
  <section class="podcast-section" id="episodes">
    <p class="podcast-section-label">Latest Episodes</p>
    <h2>On the record</h2>
    <% if (episodes.length === 0) { %>
      <div class="empty-episodes">
        <svg width="40" height="40" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" style="color: var(--text-ghost); margin: 0 auto 16px"><path d="M12 2a10 10 0 100 20A10 10 0 0012 2zM12 8v4l3 3"/></svg>
        <strong>First episodes coming soon.</strong>
        <p>Subscribe below and we'll notify you when the first episode drops.</p>
      </div>
    <% } else { %>
      <div class="episodes-grid">
        <% episodes.forEach(function(ep, i) { %>
          <div class="episode-card">
            <% if (ep.thumbnail_url) { %>
              <img class="episode-thumbnail" src="<%= ep.thumbnail_url %>" alt="Episode thumbnail" loading="lazy">
            <% } else { %>
              <img class="episode-thumbnail" src="<%= defaultThumbnail %>" alt="Episode thumbnail" loading="lazy">
            <% } %>
            <div class="episode-card-body">
              <div class="episode-meta">
                <span class="episode-badge"><%= 'EP ' + String(i + 1).padStart(2, '0') %></span>
                <% if (ep.duration_seconds) { %>
                  <span class="episode-duration"><%= Math.floor(ep.duration_seconds / 60) %> min</span>
                <% } %>
              </div>
              <div class="episode-guest"><strong><%= ep.guest_name %></strong><% if (ep.guest_company) { %> &mdash; <%= ep.guest_company %><% } %></div>
              <div class="episode-title"><%= ep.title %></div>
              <% if (ep.description) { %>
                <p class="episode-description"><%= ep.description %></p>
              <% } %>
              <div class="episode-actions">
                <% if (ep.youtube_url && ep.youtube_url.trim() !== '') { %>
                  <a href="<%= ep.youtube_url %>" target="_blank" rel="noopener" class="btn-watch">
                    <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"/><path d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                    Watch / Listen
                  </a>
                <% } else { %>
                  <span class="btn-watch disabled">
                    <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"/><path d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                    Coming Soon
                  </span>
                <% } %>
              </div>
            </div>
          </div>
        <% }) %>
      </div>
    <% } %>
  </section>

  <!-- Guest Application -->
  <section class="podcast-section" id="apply">
    <div class="apply-section">
      <div class="apply-header">
        <p class="podcast-section-label">Guest Applications</p>
        <h2>Apply to be on the show</h2>
        <p style="font-size: 15px; color: var(--text-dim); line-height: 1.7;">
          We're looking for heads of circularity, sustainability leaders, and material-recovery pioneers with a story worth telling. If you're building something that matters, we want to hear it.
        </p>
      </div>
      <form class="apply-form" id="apply-form" method="POST" action="/podcast/api/apply">
        <div class="form-grid">
          <div class="form-field">
            <label class="form-label" for="guest-name">Full Name *</label>
            <input class="form-input" type="text" id="guest-name" name="name" placeholder="Jane Smith" required>
          </div>
          <div class="form-field">
            <label class="form-label" for="guest-title">Title</label>
            <input class="form-input" type="text" id="guest-title" name="title" placeholder="Chief Sustainability Officer">
          </div>
          <div class="form-field">
            <label class="form-label" for="guest-company">Company</label>
            <input class="form-input" type="text" id="guest-company" name="company" placeholder="Acme Corp">
          </div>
          <div class="form-field">
            <label class="form-label" for="guest-linkedin">LinkedIn URL</label>
            <input class="form-input" type="url" id="guest-linkedin" name="linkedin_url" placeholder="https://linkedin.com/in/yourprofile">
          </div>
          <div class="form-field full">
            <label class="form-label" for="guest-pitch">Why you should be on Secondary Materials *</label>
            <textarea class="form-textarea" id="guest-pitch" name="pitch" placeholder="Tell us about your work, what you're building, and what story you'd bring to the show..." required></textarea>
          </div>
        </div>
        <button type="submit" class="form-submit" id="apply-submit">Submit Application</button>
        <div class="form-success" id="apply-success">Thank you! Your application has been submitted. We'll be in touch.</div>
      </form>
    </div>
  </section>

  <!-- Email Signup -->
  <section class="podcast-section" id="notify">
    <div class="signup-section">
      <p class="podcast-section-label">Stay in the loop</p>
      <h2>Get notified of new episodes</h2>
      <p style="font-size: 15px; color: var(--text-dim); margin-top: 8px;">
        New episodes drop regularly. No spam, no noise — just the circular economy conversations worth your time.
      </p>
      <form class="signup-form" id="signup-form">
        <input class="signup-input" type="email" id="sub-email" name="email" placeholder="you@yourcompany.com" required>
        <button type="submit" class="signup-submit" id="signup-submit">Subscribe</button>
      </form>
      <div class="signup-success" id="signup-success">You're on the list. First episodes coming soon.</div>
    </div>
  </section>

  <!-- Footer -->
  <footer class="podcast-footer">
    <div class="podcast-footer-inner">
      <div class="podcast-footer-brand">
        <svg viewBox="0 0 28 28" fill="none">
          <rect width="28" height="28" rx="6" fill="#1d4731"/>
          <path d="M14 5 L22.5 21 H5.5 Z" fill="#a8d96c"/>
        </svg>
        <span>WastetideOS</span>
      </div>
