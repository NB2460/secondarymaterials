  // ── Ticket → PNG ─────────────────────────────────────────────────────
  // Redraws the ticket on a canvas from the result data, so the download is
  // a clean image (not a print of the page) and can be shared anywhere.
  async function downloadTicket(btn) {
    if (!lastResult) return;
    const label = btn.textContent; btn.disabled = true; btn.textContent = 'Preparing…';
    try {
      await document.fonts.ready;
      const data = lastResult, mats = data.materials || [];
      const S = 2, W = 420, PAD = 28, BG = 40;
      const css = (v) => getComputedStyle(document.documentElement).getPropertyValue(v).trim();
      const colour = (k) => { const v = binColor(k).match(/var\((--[^)]+)\)/); return v ? css(v[1]) : '#3A403B'; };
      const lineH = 22, ticketH = 150 + mats.length * lineH + 210;
      const cv = document.createElement('canvas');
      cv.width = (W + BG * 2) * S; cv.height = (ticketH + BG * 2) * S;
      const x = cv.getContext('2d'); x.scale(S, S);
      x.fillStyle = css('--ground') || '#E7E8E4'; x.fillRect(0, 0, W + BG * 2, ticketH + BG * 2);
      x.translate(BG, BG);
      // paper + shadow
      x.save(); x.shadowColor = 'rgba(18,22,19,0.22)'; x.shadowBlur = 24; x.shadowOffsetY = 10;
      x.fillStyle = '#fff'; x.fillRect(0, 0, W, ticketH); x.restore();
      // perforated top edge
      x.fillStyle = css('--ground') || '#E7E8E4';
      for (let px = 11; px < W; px += 22) { x.beginPath(); x.arc(px, 0, 4, 0, Math.PI * 2); x.fill(); }
      const ink = '#121613', muted = '#5F665F', mono = (w, sz) => `${w} ${sz}px "Space Mono", ui-monospace, monospace`;
      const dashed = (yy) => { x.save(); x.strokeStyle = ink; x.setLineDash([4, 3]); x.beginPath(); x.moveTo(PAD, yy); x.lineTo(W - PAD, yy); x.stroke(); x.restore(); };
      let y = 46;
      x.textAlign = 'center'; x.fillStyle = ink; x.font = mono(700, 15); x.fillText('WASTESCOPE', W / 2, y);
      x.fillStyle = muted; x.font = mono(400, 11);
      const date = new Date().toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' }).toUpperCase();
      x.fillText((lastSample ? 'SAMPLE TICKET' : 'YOUR TICKET') + ' · No ' + String(ticketNo).padStart(4, '0'), W / 2, y += 22);
      x.fillText(date + ' · US MARKET', W / 2, y += 17);
      dashed(y += 18);
      y += 26; x.font = mono(400, 12);
      mats.forEach(m => {
        x.fillStyle = colour(m.material_key); x.fillRect(PAD, y - 9, 8, 8);
        x.fillStyle = ink; x.textAlign = 'left';
        x.fillText(((m.label || m.material_key) + ' ' + Math.round(m.weight_kg) + 'KG').toUpperCase(), PAD + 16, y);
        x.textAlign = 'right'; x.fillText(fmt2(m.value_usd), W - PAD, y);
        y += lineH;
      });
      dashed(y += 2);
      y += 40; x.textAlign = 'left'; x.font = mono(700, 13); x.fillText('TOTAL', PAD, y);
      x.textAlign = 'right'; x.font = mono(700, 28); x.fillText(fmtUSD(data.summary.total_value_usd), W - PAD, y + 2);
      y += 28; x.font = mono(400, 11); x.fillStyle = muted;
      x.textAlign = 'left'; x.fillText('CO2 AVOIDED', PAD, y); x.textAlign = 'right'; x.fillText(Math.round(data.summary.total_co2_avoided_kg) + ' kg', W - PAD, y);
      // stamp
      x.save(); x.translate(W - PAD - 62, y + 40); x.rotate(-8 * Math.PI / 180);
      x.strokeStyle = css('--ok') || '#2F7D45'; x.fillStyle = x.strokeStyle; x.lineWidth = 2;
      x.strokeRect(-58, -14, 116, 28); x.font = mono(700, 12); x.textAlign = 'center'; if ('letterSpacing' in x) x.letterSpacing = '2px'; x.fillText('ESTIMATE', 0, 5); x.restore();
      dashed(y += 78);
      x.fillStyle = ink; x.textAlign = 'center'; x.font = mono(400, 11);
      x.fillText('GET REAL OFFERS → WASTETIDE.AI', W / 2, y += 26);
      x.fillStyle = muted; x.font = mono(400, 9);
      x.fillText('Estimate from reference prices — not a buyer offer.', W / 2, y += 18);
      const blob = await new Promise(r => cv.toBlob(r, 'image/png'));
      const a = el('a', { href: URL.createObjectURL(blob), download: 'wastescope-ticket-' + String(ticketNo).padStart(4, '0') + '.png' });
      document.body.append(a); a.click(); a.remove(); setTimeout(() => URL.revokeObjectURL(a.href), 2000);
    } finally {
      btn.disabled = false; btn.textContent = label;
    }
  }

  // ── Wiring ───────────────────────────────────────────────────────────
  document.addEventListener('click', (e) => {
    const t = e.target.closest('[data-action]'); if (!t) return;
    const a = t.dataset.action;
    if (a === 'choose') { clearTimeout(autoScanTimer); fileInput.click(); }
    if (a === 'camera') cameraInput.click();
    if (a === 'retry') scan();
    if (a === 'download') { track('form_submitted', { action: 'download_ticket' }); downloadTicket(t); }
  });
  $('#scan-btn').addEventListener('click', scan);
  [fileInput, cameraInput].forEach(inp => inp.addEventListener('change', () => { onFile(inp.files[0]); inp.value = ''; }));
  ['dragenter', 'dragover'].forEach(ev => screen.addEventListener(ev, (e) => { e.preventDefault(); screen.classList.add('dragover'); }));
  ['dragleave', 'drop'].forEach(ev => screen.addEventListener(ev, (e) => { e.preventDefault(); screen.classList.remove('dragover'); }));
  screen.addEventListener('drop', (e) => onFile(e.dataTransfer.files[0]));

  const samplesEl = $('#samples');
  let sampleTimer = null;
  function runSample(s, btn) {
    if (screen.dataset.state === 'scanning') return;
    clearTimeout(sampleTimer);
    currentFile = null;
    samplesEl.querySelectorAll('.sample').forEach(x => x.setAttribute('aria-pressed', String(x === btn)));
    photo.classList.remove('placeholder');
    photo.style.backgroundImage = ART[s.id];
    $('#scan-notes').hidden = true;
    startScanVisuals({ fast: true });
    // Same animation as a real scan, shorter, no API call and no free scan used.
    sampleTimer = setTimeout(() => { stepTimers.forEach(clearTimeout); setStep('price', 100); showResult(s.data, { sampleTicket: true }); }, 1700);
  }
  SAMPLES.forEach(s => {
    const thumb = el('span', { className: 'thumb' }); thumb.style.setProperty('--art', ART[s.id]);
    const b = el('button', { type: 'button', className: 'sample', ariaPressed: 'false', ariaLabel: 'Try sample: ' + s.label },
      thumb, el('span', { className: 'name', textContent: s.label, title: s.label }), el('span', { className: 'val', textContent: '≈ ' + fmtUSD(s.data.summary.total_value_usd) }));
    b.addEventListener('click', () => runSample(s, b));
    samplesEl.append(b);
  });

  // Initial: show the sample ticket so the stage is never empty.
  setState('idle');
  renderTicket(SAMPLES[0].data, { sampleTicket: true, animate: false });
  track('page_view', { path: '/wastescope' });
})();
</script>
</body>
</html>
