    updateYearly();
  }));

  // ── Photo check (client-side, before any API call) ───────────────────
  function checkPhoto(file) {
    return new Promise((resolve) => {
      const results = [];
      const img = new Image();
      img.onload = () => {
        const short = Math.min(img.naturalWidth, img.naturalHeight);
        // The vision model reads 512px images fine; only block thumbnails it can't use.
        results.push(short >= 600 ? { level: 'ok', text: 'Sharp enough' } : short >= 200 ? { level: 'warn', text: 'Small photo', note: '— small materials may be missed' } : { level: 'bad', text: 'Photo too small to read', note: '— use the original photo' });
        const c = document.createElement('canvas'); c.width = 48; c.height = 48;
        const ctx = c.getContext('2d'); ctx.drawImage(img, 0, 0, 48, 48);
        const px = ctx.getImageData(0, 0, 48, 48).data; let sum = 0;
        for (let i = 0; i < px.length; i += 4) sum += 0.2126 * px[i] + 0.7152 * px[i + 1] + 0.0722 * px[i + 2];
        const lum = sum / (px.length / 4);
        currentHint = colourHint(px);
        results.push(lum < 55 ? { level: 'warn', text: 'Photo is dark', note: '— daylight works best' } : lum > 225 ? { level: 'warn', text: 'Photo is overexposed', note: '— avoid flash' } : { level: 'ok', text: 'Good light' });
        results.push({ level: 'tip', text: 'Whole pile and an object for scale?', note: '— improves the weight estimate' });
        resolve(results);
      };
      img.onerror = () => resolve([{ level: 'warn', text: "Can't preview this format", note: '— we can still try to scan it' }, { level: 'tip', text: 'Whole pile and an object for scale?', note: '' }]);
      img.src = currentUrl;
    });
  }

  // Coarse material family from colour, sent along with the photo. The server only
  // uses it when no vision model is configured (local dev); the real model ignores it.
  function colourHint(px) {
    const bins = { orange: 0, green: 0, colourful: 0, grey: 0 }; const hues = new Set();
    for (let i = 0; i < px.length; i += 4) {
      const r = px[i] / 255, g = px[i + 1] / 255, b = px[i + 2] / 255;
      const max = Math.max(r, g, b), min = Math.min(r, g, b), d = max - min;
      const sat = max ? d / max : 0;
      if (sat < 0.22 || max < 0.18) { bins.grey++; continue; }
      let h = 0;
      if (d) h = max === r ? ((g - b) / d) % 6 : max === g ? (b - r) / d + 2 : (r - g) / d + 4;
      h = (h * 60 + 360) % 360;
      hues.add(Math.floor(h / 30));
      if (h >= 12 && h < 45) bins.orange++; else if (h >= 80 && h < 165) bins.green++; else bins.colourful++;
    }
    const n = px.length / 4;
    if (hues.size >= 7 && bins.grey < n * 0.6) return 'plastics';
    if (bins.orange > n * 0.25) return 'copper';
    if (bins.green > n * 0.25) return 'pcb';
    return bins.colourful > n * 0.3 ? 'plastics' : 'metal';
  }

  // iPhones save HEIC by default: browsers can't display it and the vision model
  // can't read it, so convert to JPEG before anything else.
  const isHeic = (f) => /image\/hei[cf]/i.test(f.type) || /\.hei[cf]$/i.test(f.name);
  let heicLib = null;
  function loadHeicLib() {
    if (heicLib) return heicLib;
    heicLib = new Promise((resolve, reject) => {
      const sc = document.createElement('script');
      sc.src = 'https://cdn.jsdelivr.net/npm/heic2any@0.0.4/dist/heic2any.min.js';
      sc.onload = () => resolve(window.heic2any); sc.onerror = () => { heicLib = null; reject(new Error('converter unavailable')); };
      document.head.append(sc);
    });
    return heicLib;
  }
  async function toJpeg(file) {
    const heic2any = await loadHeicLib();
    const out = await heic2any({ blob: file, toType: 'image/jpeg', quality: 0.9 });
    const blob = Array.isArray(out) ? out[0] : out;
    return new File([blob], file.name.replace(/\.hei[cf]$/i, '') + '.jpg', { type: 'image/jpeg' });
  }

  let autoScanTimer = null;
  async function onFile(file) {
    if (!file) return;
    clearTimeout(autoScanTimer);
    if (!file.type.startsWith('image/') && !isHeic(file)) { showError('That file is not an image.'); return; }
    if (file.size > MAX_BYTES) { showError('That photo is over 20 MB.'); return; }
    if (isHeic(file)) {
      setState('check');
      $('#hud-status').textContent = 'Converting iPhone photo…';
      $('#checks').replaceChildren(el('li', { className: 'tip' }, el('span', { className: 'dot', textContent: '…' }), 'Converting your iPhone photo'));
      $('#scan-btn').disabled = true;
      try { file = await toJpeg(file); }
      catch (_) { showError("We couldn't open this iPhone photo. Try again, or share it as JPG."); return; }
      $('#hud-status').textContent = 'Checking your photo';
    }
    if (left() <= 0) { currentFile = file; setPhoto(file); setState('wall'); track('lead_gate_shown', { reason: 'quota' }); return; }
    currentFile = file; setPhoto(file);
    const checks = await checkPhoto(file);
    if (currentFile !== file) return; // a newer photo replaced this one
    const blocked = checks.some(ch => ch.level === 'bad');
    if (!blocked) {
      // No pause: scan right away, carry any warning into the scan panel.
      const warn = checks.find(ch => ch.level === 'warn');
      const notes = $('#scan-notes');
      notes.replaceChildren(...(warn ? [el('span', { className: 'dot', textContent: '!' }), warn.text + ' ' + (warn.note || '')] : []));
      notes.hidden = !warn;
      scan();
      return;
    }
    // Unusable photo: stop and explain.
    setState('check');
    const list = $('#checks'); list.replaceChildren();
    const icon = { ok: '✓', warn: '!', bad: '✕', tip: '?' };
    checks.forEach(ch => list.append(el('li', { className: ch.level }, el('span', { className: 'dot', textContent: icon[ch.level], ariaHidden: 'true' }), ch.text, ch.note ? el('small', { textContent: ' ' + ch.note }) : '')));
    $('#scan-btn').disabled = true;
  }
  function setPhoto(file) {
    if (currentUrl) URL.revokeObjectURL(currentUrl);
    currentUrl = URL.createObjectURL(file);
    photo.classList.remove('placeholder');
    photo.style.backgroundImage = 'url("' + currentUrl + '")';
  }

  // ── Scan ─────────────────────────────────────────────────────────────
  let stepTimers = [];
  function setStep(name, pct) {
    const order = ['upload', 'identify', 'price'];
    const idx = order.indexOf(name);
    document.querySelectorAll('#steps li').forEach((li, i) => { li.dataset.done = String(i < idx); li.dataset.active = String(i === idx); });
    $('#bar').style.width = pct + '%';
  }
  async function scan() {
    if (!currentFile) return;
    samplesEl.querySelectorAll('.sample').forEach(x => x.setAttribute('aria-pressed', 'false'));
    startScanVisuals({ fast: false });
    track('scan_started', { file_size_bytes: currentFile.size });
    try {
      const fd = new FormData(); fd.append('hint', currentHint); fd.append('photo', currentFile);
      const res = await fetch('/api/analyze', { method: 'POST', body: fd });
      const data = await res.json().catch(() => ({}));
      if (!res.ok || !data.success) {
        // Keep server internals out of the UI; 4xx messages are user-facing (bad file, too big).
        throw new Error(res.status >= 500 || !data.error ? 'Our analyser is unavailable right now.' : data.error);
      }
      stepTimers.forEach(clearTimeout); setStep('price', 100);
      store.used = store.used + 1;
      track('scan_completed', { material_count: (data.materials || []).length, total_value_usd: data.summary && data.summary.total_value_usd });
      showResult(data, { sampleTicket: false });
    } catch (err) {
      stepTimers.forEach(clearTimeout);
      showError(err.message);
    }
  }
  function startScanVisuals({ fast }) {
    setState('scanning'); setStep('upload', 12);
    stepTimers.forEach(clearTimeout);
    stepTimers = fast
      ? [setTimeout(() => setStep('identify', 45), 450), setTimeout(() => setStep('price', 80), 1100)]
      : [setTimeout(() => setStep('identify', 45), 900), setTimeout(() => setStep('price', 80), 2600)];
    // Detection blips inside the frame, staggered so they appear as the beam passes.
    const blips = $('#blips'); blips.replaceChildren();
    const n = fast ? 5 : 7, gap = fast ? 220 : 260;
    for (let i = 0; i < n; i++) {
      const b = el('i', { className: 'blip' });
      b.style.left = (12 + Math.random() * 72) + '%'; b.style.top = (16 + Math.random() * 52) + '%';
      b.style.setProperty('--d', (200 + i * gap) + 'ms');
      blips.append(b);
    }
  }
  function showError(msg) { $('#error-msg').textContent = msg; setState('error'); }

  // ── Wall (lead) ──────────────────────────────────────────────────────
  $('#wall-form').addEventListener('submit', async (e) => {
    e.preventDefault();
    const name = $('#lead-name'), email = $('#lead-email');
    const setErr = (input, node, msg) => { input.setAttribute('aria-invalid', msg ? 'true' : 'false'); node.textContent = msg || ''; node.hidden = !msg; };
    setErr(name, $('#err-name'), name.value.trim() ? '' : 'Add your name.');
    setErr(email, $('#err-email'), /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email.value.trim()) ? '' : 'Enter a work email, like jane@company.com.');
    const firstBad = [name, email].find(i => i.getAttribute('aria-invalid') === 'true');
    if (firstBad) { firstBad.focus(); return; }
    const btn = $('#wall-submit'), formErr = $('#err-form');
    btn.disabled = true; btn.textContent = 'Unlocking…'; formErr.hidden = true;
    try {
      const res = await fetch('/api/leads', { method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ name: name.value.trim(), email: email.value.trim(), scan_data: lastResult, source: SOURCE }) });
      const data = await res.json().catch(() => ({}));
      if (!res.ok || !data.success) throw new Error(data.error || 'Could not save your details.');
      store.unlocked = true;
      track('lead_submitted', {});
      if (currentFile) { setState('check'); onFile(currentFile); } else setState('idle');
    } catch (err) {
