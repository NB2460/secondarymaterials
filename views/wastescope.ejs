  }

  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  let countRaf = null;
  function countUp(node, target, delay) {
    cancelAnimationFrame(countRaf);
    if (reduceMotion.matches) { node.textContent = fmtUSD(target); return; }
    node.textContent = fmtUSD(0);
    const start = performance.now() + delay, dur = 650;
    const tick = (now) => {
      const t = Math.min(1, Math.max(0, (now - start) / dur));
      node.textContent = fmtUSD(target * (1 - Math.pow(1 - t, 3)));
      if (t < 1) countRaf = requestAnimationFrame(tick);
    };
    countRaf = requestAnimationFrame(tick);
  }

  function showResult(data, { sampleTicket }) {
    lastResult = data; lastSample = !!sampleTicket;
