    const chips = $('#chips'); chips.replaceChildren();
    const mats = data.materials || [];
    const maxChips = window.matchMedia('(max-width: 560px)').matches ? 2 : 3; // keep the photo visible
    mats.slice(0, maxChips).forEach(mat => {
      const sw = el('i', { className: 'swatch' }); sw.style.background = binColor(mat.material_key);
      const chip = el('span', { className: 'chip' }); chip.style.setProperty('--i', chips.children.length);
      chips.append(chip); chip.append(sw, mat.label || mat.material_key, el('span', { textContent: Math.round(mat.weight_kg) + ' kg' + (mat.confidence_pct ? ' · ' + mat.confidence_pct + '%' : '') }));
    });
    if (mats.length > maxChips) { const more = el('span', { className: 'chip', textContent: '+' + (mats.length - maxChips) + ' more on the ticket' }); more.style.setProperty('--i', maxChips); chips.append(more); }
