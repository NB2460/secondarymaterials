      const sw = el('i', { className: 'swatch' }); sw.style.background = binColor(mat.material_key);
      lines.append(el('li', { dataset: { line: '' } },
        el('span', {}, sw, el('span', { textContent: (mat.label || mat.material_key) + ' ' + Math.round(mat.weight_kg) + 'kg' })),
