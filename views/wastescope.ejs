    updateYearly();
  }

  let freq = 12;
  function updateYearly() {
    if (!lastResult) return;
    $('#wt-yearly').textContent = "That's ≈ " + fmtUSD(lastResult.summary.total_value_usd * freq) + ' a year you could recover.';
  }
  document.querySelectorAll('[data-freq]').forEach(b => b.addEventListener('click', () => {
