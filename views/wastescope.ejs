<script>
(() => {
  // ── Config ───────────────────────────────────────────────────────────
  const FREE_SCANS = 3;
  const UNLOCK_SCANS = 10;
  const MAX_BYTES = 20 * 1024 * 1024;
  const SOURCE = 'wastescope';
  // Prototype quota lives in localStorage; the real limit must be enforced server-side.
  const store = {
    get used() { return Number(localStorage.getItem('ws_used') || 0); },
    set used(v) { localStorage.setItem('ws_used', String(v)); },
    get unlocked() { return localStorage.getItem('ws_unlocked') === '1'; },
    set unlocked(v) { localStorage.setItem('ws_unlocked', v ? '1' : '0'); },
  };
  // Prototype helper: /wastescope?reset clears the local quota.
  if (new URLSearchParams(location.search).has('reset')) {
    localStorage.removeItem('ws_used'); localStorage.removeItem('ws_unlocked');
    history.replaceState(null, '', location.pathname);
  }
  const limit = () => FREE_SCANS + (store.unlocked ? UNLOCK_SCANS : 0);
  const left = () => Math.max(0, limit() - store.used);

  const BIN = {
    copper: 'var(--bin-copper)', brass: 'var(--bin-brass)', circuit_boards: 'var(--bin-pcb)',
    aluminum: 'var(--bin-alu)', stainless_steel: 'var(--bin-alu)', steel: 'var(--bin-alu)', zinc: 'var(--bin-alu)', lead: 'var(--bin-alu)',
    plastic_hdpe: 'var(--bin-plastic)', plastic_abs: 'var(--bin-plastic)', plastic_pp: 'var(--bin-plastic)',
  };
  const binColor = (key) => BIN[key] || 'var(--bin-other)';

  // Samples use the same price / CO₂ tables as /api/analyze, precomputed.
  const m = (key, label, kg, price, co2) => ({ material_key: key, label, weight_kg: kg, price_per_kg: price, value_usd: +(kg * price).toFixed(2), co2_avoided_kg: +(kg * co2).toFixed(1) });
  const sample = (name, materials) => {
    const total = materials.reduce((s, x) => s + x.value_usd, 0);
    const kg = materials.reduce((s, x) => s + x.weight_kg, 0);
    const co2 = materials.reduce((s, x) => s + x.co2_avoided_kg, 0);
    return { sample: true, scene_description: name, confidence: 'high', materials,
      summary: { total_value_usd: +total.toFixed(2), total_weight_kg: kg, total_co2_avoided_kg: +co2.toFixed(1), car_days_avoided: +(co2 / (4600 / 365)).toFixed(1) } };
  };
  // Real sample photos (credits in the footer), over an abstract pile in the
  // material's bin colours that shows while the photo loads.
  const PHOTO = { copper: 'copper', pcb: 'electronics', alu: 'aluminium', plastic: 'plastics' };
  const FALLBACK = {
    copper: 'repeating-linear-gradient(118deg, rgba(255,255,255,0.07) 0 2px, transparent 2px 9px), radial-gradient(ellipse 30% 24% at 30% 60%, #EBA567 0%, rgba(235,165,103,0) 100%), radial-gradient(ellipse 28% 22% at 62% 50%, #C46A2B 0%, rgba(196,106,43,0) 100%), radial-gradient(ellipse 18% 14% at 78% 70%, #D9B44A 0%, rgba(217,180,74,0) 100%), radial-gradient(ellipse 55% 30% at 50% 92%, #24150C 0%, rgba(36,21,12,0) 100%), linear-gradient(180deg, #A08A76 0%, #7A5235 55%, #3A2416 100%)',
    pcb: 'repeating-linear-gradient(90deg, rgba(201,162,58,0.35) 0 1px, transparent 1px 14px), repeating-linear-gradient(0deg, rgba(201,162,58,0.25) 0 1px, transparent 1px 18px), radial-gradient(ellipse 30% 26% at 34% 46%, #6FBF73 0%, rgba(111,191,115,0) 100%), radial-gradient(ellipse 28% 24% at 70% 62%, #2F7D45 0%, rgba(47,125,69,0) 100%), linear-gradient(180deg, #355E3F 0%, #1E3B26 55%, #0F2316 100%)',
    alu: 'repeating-linear-gradient(100deg, rgba(255,255,255,0.18) 0 3px, transparent 3px 16px), radial-gradient(ellipse 34% 26% at 36% 56%, #F1F4F5 0%, rgba(241,244,245,0) 100%), radial-gradient(ellipse 30% 24% at 68% 46%, #B9C4C6 0%, rgba(185,196,198,0) 100%), linear-gradient(180deg, #A9B2B4 0%, #7C8689 55%, #4C5557 100%)',
    plastic: 'radial-gradient(circle at 22% 40%, #E0533F 0 7%, rgba(224,83,63,0) 8%), radial-gradient(circle at 48% 66%, #F2C14E 0 6%, rgba(242,193,78,0) 7%), radial-gradient(circle at 70% 34%, #5FBF3F 0 6%, rgba(95,191,63,0) 7%), radial-gradient(circle at 82% 70%, #E0533F 0 5%, rgba(224,83,63,0) 6%), radial-gradient(ellipse 34% 28% at 38% 52%, #CFE3F2 0%, rgba(207,227,242,0) 100%), radial-gradient(ellipse 30% 26% at 66% 58%, #3D7FB3 0%, rgba(61,127,179,0) 100%), linear-gradient(180deg, #9FB4C6 0%, #6F879C 55%, #3F5466 100%)',
  };
  const ART = Object.fromEntries(Object.entries(FALLBACK).map(([k, g]) => [k, 'url("/img/wastescope/' + PHOTO[k] + '.jpg"), ' + g]));
  Object.values(PHOTO).forEach(n => { const i = new Image(); i.src = '/img/wastescope/' + n + '.jpg'; }); // preload
