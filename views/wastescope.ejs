<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>WasteScope — See what your waste is worth</title>
  <meta name="description" content="Point your phone at a pile of industrial waste. WasteScope names the materials, estimates the weight and prints a ticket with its resale value. Free, by Wastetide.">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,400..800&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">
  <style>
    :root {
      --ground: #E7E8E4;
      --screen: #0E1210;
      --paper: #FFFFFF;
      --ink: #121613;
      --ink-2: #3A403B;
      --muted: #5F665F;
      --line: rgba(18, 22, 19, 0.12);
      --lime: #C6F36B;
      --ok: #2F7D45;
      --warn: #D98A1E;
      --bad: #C2412D;
      --bin-copper: #C46A2B;
      --bin-brass: #C9A23A;
      --bin-pcb: #3F8F4A;
      --bin-alu: #9AA6A8;
      --bin-plastic: #3D7FB3;
      --bin-other: #3A403B;
      --r-sm: 4px;   /* tags, chips, swatches */
      --r-md: 8px;   /* buttons, inputs, tiles */
      --r-lg: 12px;  /* panels, cards */
      --r-xl: 18px;  /* viewfinder */
      --bad-on-dark: #FF9C88;
      --font: 'Archivo', system-ui, sans-serif;
      --mono: 'Space Mono', ui-monospace, monospace;
    }

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html { scrollbar-gutter: stable; }
    body {
      min-height: 100vh; display: flex; flex-direction: column;
      font-family: var(--font);
      background: var(--ground);
      color: var(--ink);
      line-height: 1.5;
      -webkit-font-smoothing: antialiased;
      text-rendering: optimizeLegibility;
    }
    a { color: inherit; }
    button { font: inherit; cursor: pointer; border: 0; background: none; color: inherit; }
    button:focus-visible, a:focus-visible, input:focus-visible, label:focus-within {
      outline: 2px solid var(--ink);
      outline-offset: 2px;
    }
    .screen button:focus-visible { outline-color: var(--lime); }
    [hidden] { display: none !important; }
    .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }

    /* ── Nav ─────────────────────────────────────────── */
    .nav { display: flex; align-items: center; justify-content: space-between; padding: 16px 64px; }
    .logo { display: flex; align-items: center; gap: 12px; text-decoration: none; font-weight: 700; font-stretch: 85%; font-size: 1.25rem; letter-spacing: -0.01em; }
    .nav-links { display: flex; align-items: center; gap: 28px; font-size: 0.9375rem; }
    .nav-links a { text-decoration: none; }
    .nav-links .by { color: var(--muted); }
    .btn {
      display: inline-flex; align-items: center; gap: 8px;
      padding: 12px 20px; border-radius: var(--r-md);
      font-weight: 600; font-size: 0.9375rem; line-height: 1;
      transition: transform 120ms ease, background-color 160ms ease;
      text-decoration: none;
    }
    .btn:active { transform: scale(0.98); }
    .btn-ink { background: var(--ink); color: #fff; }
    .btn-lime { background: var(--lime); color: var(--screen); }
    .btn-ghost-dark { border: 1px solid rgba(18,22,19,0.2); color: var(--ink); background: rgba(255,255,255,0.6); }
    .btn[disabled] { opacity: 0.5; cursor: not-allowed; transform: none; }

    /* ── Hero ────────────────────────────────────────── */
    .hero { flex: 1; display: grid; grid-template-columns: 400px 1fr; column-gap: 96px; row-gap: 48px; align-items: center; align-content: center; padding: 0 64px 16px; width: 100%; max-width: 1440px; margin: 0 auto; }
    .eyebrow { font-family: var(--mono); font-size: 0.75rem; letter-spacing: 0.1em; color: var(--muted); text-transform: uppercase; }
    h1 { font-size: 4rem; line-height: 1; font-weight: 600; font-stretch: 85%; letter-spacing: -0.025em; margin: 20px 0 24px; text-wrap: balance; }
    .lede { font-size: 1.125rem; line-height: 1.55; color: var(--ink-2); text-wrap: pretty; }
    .side-block { margin-top: 28px; }
    .samples { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 8px; margin-top: 10px; }
    .sample { display: flex; flex-direction: column; gap: 8px; padding: 6px 6px 8px; background: var(--paper); border-radius: var(--r-md); text-align: left;
      box-shadow: 0 0 0 1px rgba(18,22,19,0.08);
      transition: transform 150ms cubic-bezier(0.16, 1, 0.3, 1), box-shadow 150ms cubic-bezier(0.16, 1, 0.3, 1); }
    .sample:hover { transform: translateY(-2px); box-shadow: 0 0 0 1px rgba(18,22,19,0.18), 0 8px 18px -10px rgba(18,22,19,0.35); }
    .sample:active { transform: scale(0.97); }
    .sample[aria-pressed="true"] { box-shadow: 0 0 0 2px var(--ink); }
    .sample .thumb { position: relative; height: 58px; border-radius: var(--r-sm); background-image: var(--art); background-size: cover; background-position: center; overflow: hidden; }
    .sample .thumb::after { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, rgba(255,255,255,0.12), rgba(0,0,0,0.12)); }
    .sample .name { display: block; font-size: 0.8125rem; font-weight: 600; line-height: 1.2; padding: 0 2px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .sample .val { font-family: var(--mono); font-size: 0.75rem; color: var(--muted); padding: 0 2px; font-variant-numeric: tabular-nums; }
    .swatch { width: 10px; height: 10px; flex-shrink: 0; }

    .wt-strip { margin-top: 24px; width: min(560px, calc(100% - 290px)); display: flex; align-items: center; gap: 12px; flex-wrap: wrap;
      padding: 16px 20px; background: var(--paper); border-radius: var(--r-lg); box-shadow: 0 0 0 1px rgba(18,22,19,0.08);
      animation: chip-in 260ms cubic-bezier(0, 0, 0.2, 1) both; animation-delay: 600ms; }
    .wt-strip-text { flex: 1 1 200px; min-width: 0; }
    .wt-strip p { font-size: 1rem; line-height: 1.35; font-weight: 600; font-stretch: 90%; margin-top: 2px; }
    .freq { display: inline-flex; border: 1px solid var(--line); border-radius: var(--r-md); overflow: hidden; font-size: 0.8125rem; }
    .freq button { min-height: 40px; padding: 8px 12px; color: var(--muted); }
    .freq button[aria-pressed="true"] { background: var(--ink); color: #fff; }

    /* ── Stage: viewfinder + ticket ──────────────────── */
    .stage { position: relative; min-height: 736px; padding-top: 40px; }
    .screen {
      position: relative; width: min(640px, calc(100% - 200px)); aspect-ratio: 4 / 3;
      background: var(--screen); border-radius: var(--r-xl); overflow: hidden;
      box-shadow: 0 30px 60px -20px rgba(14,18,16,0.45);
      color: #fff;
    }
    .photo { position: absolute; inset: 0; background-size: cover; background-position: center; }
    .photo.placeholder {
      background-color: #6B6458;
      background-image:
        radial-gradient(ellipse 38% 30% at 34% 62%, #D08A4A 0%, rgba(208,138,74,0) 100%),
        radial-gradient(ellipse 30% 26% at 68% 58%, #A7B2B3 0%, rgba(167,178,179,0) 100%),
        radial-gradient(ellipse 60% 30% at 50% 88%, #4A3220 0%, rgba(74,50,32,0) 100%),
        linear-gradient(180deg, #B9BCB4 0%, #8B8579 50%, #3B332A 100%);
      filter: blur(2px);
    }
    /* Scanning: a lime beam sweeps the frame, brackets tighten, detection blips appear. */
    .beam { position: absolute; inset: 0; pointer-events: none; opacity: 0; transform: translateY(-100%);
      background: linear-gradient(180deg, rgba(198,243,107,0) 0%, rgba(198,243,107,0) 70%, rgba(198,243,107,0.22) calc(100% - 2px), var(--lime) calc(100% - 2px)); }
    .screen[data-state="scanning"] .beam { opacity: 1; animation: sweep 1500ms cubic-bezier(0.45, 0, 0.55, 1) infinite alternate; }
    @keyframes sweep { from { transform: translateY(-100%); } to { transform: translateY(0); } }
    .corners { transition: transform 300ms cubic-bezier(0.16, 1, 0.3, 1); }
    .screen[data-state="scanning"] .corners { transform: scale(0.94); }
    .blips { position: absolute; inset: 0; pointer-events: none; }
    .blip { position: absolute; width: 14px; height: 14px; border: 1.5px solid var(--lime); border-radius: var(--r-sm); opacity: 0;
      animation: blip 900ms cubic-bezier(0.16, 1, 0.3, 1) both; animation-delay: var(--d); }
    @keyframes blip { 0% { opacity: 0; transform: scale(0.85); } 25% { opacity: 1; transform: scale(1); } 100% { opacity: 0.55; transform: scale(1); } }
    .screen:not([data-state="scanning"]) .blips { display: none; }
    .chip { animation: chip-in 260ms cubic-bezier(0, 0, 0.2, 1) both; animation-delay: calc(var(--i, 0) * 80ms); }
    @keyframes chip-in { from { opacity: 0; transform: translateY(8px); } }
    .scrim { position: absolute; inset: 0; background-color: rgba(10,12,10,0.30); background-image: linear-gradient(180deg, rgba(10,12,10,0.55) 0%, rgba(10,12,10,0) 18%); transition: background-color 240ms ease; }
    .hud { text-shadow: 0 1px 2px rgba(0,0,0,0.5); }
    .screen[data-state="check"] .scrim,
    .screen[data-state="result"] .scrim { background-color: rgba(10,12,10,0.10); }
    .screen[data-state="scanning"] .scrim { background-color: rgba(10,12,10,0.45); }
    .grid-lines { position: absolute; inset: 0; pointer-events: none;
      background:
        linear-gradient(90deg, transparent calc(33.33% - 0.5px), rgba(255,255,255,0.08) calc(33.33% - 0.5px), rgba(255,255,255,0.08) calc(33.33% + 0.5px), transparent calc(33.33% + 0.5px), transparent calc(66.66% - 0.5px), rgba(255,255,255,0.08) calc(66.66% - 0.5px), rgba(255,255,255,0.08) calc(66.66% + 0.5px), transparent calc(66.66% + 0.5px)),
        linear-gradient(180deg, transparent calc(33.33% - 0.5px), rgba(255,255,255,0.08) calc(33.33% - 0.5px), rgba(255,255,255,0.08) calc(33.33% + 0.5px), transparent calc(33.33% + 0.5px), transparent calc(66.66% - 0.5px), rgba(255,255,255,0.08) calc(66.66% - 0.5px), rgba(255,255,255,0.08) calc(66.66% + 0.5px), transparent calc(66.66% + 0.5px));
    }
    .corners { position: absolute; left: 6.25%; right: 6.25%; top: 11.7%; bottom: 22%; pointer-events: none; }
    .corners i { position: absolute; width: 40px; height: 40px; border-color: #fff; border-style: solid; border-width: 0; transition: border-color 240ms ease; }
    .corners i:nth-child(1) { left: 0; top: 0; border-left-width: 3px; border-top-width: 3px; }
    .corners i:nth-child(2) { right: 0; top: 0; border-right-width: 3px; border-top-width: 3px; }
    .corners i:nth-child(3) { left: 0; bottom: 0; border-left-width: 3px; border-bottom-width: 3px; }
    .corners i:nth-child(4) { right: 0; bottom: 0; border-right-width: 3px; border-bottom-width: 3px; }
    .screen[data-state="check"] .corners i,
    .screen[data-state="scanning"] .corners i,
    .screen[data-state="result"] .corners i { border-color: var(--lime); }

    .hud { position: absolute; left: 24px; right: 24px; display: flex; justify-content: space-between; gap: 12px; font-family: var(--mono); font-size: 0.75rem; letter-spacing: 0.08em; text-transform: uppercase; }
    .hud-top { top: 18px; }
    .hud-top .status { color: var(--lime); display: flex; align-items: center; gap: 8px; }
    .hud-top .status::before { content: ''; width: 8px; height: 8px; border-radius: var(--r-sm); background: currentColor; }
    .hud-top .meta { color: rgba(255,255,255,0.75); }
    .hud-top .status { white-space: nowrap; }
    .screen[data-state="error"] .hud-top .status { color: var(--bad-on-dark); }
    .hud-bottom { bottom: 18px; justify-content: flex-start; gap: 16px; flex-wrap: wrap; }
    .hud-bottom .ok { color: var(--lime); }
    .hud-bottom .no { color: rgba(255,255,255,0.55); }

    .panel {
      position: absolute; background: rgba(255,255,255,0.92); color: var(--ink);
      border-radius: var(--r-lg); box-shadow: 0 12px 32px -8px rgba(10,12,10,0.35);
      -webkit-backdrop-filter: blur(14px); backdrop-filter: blur(14px);
    }
    .drop-panel { left: 50%; top: 50%; transform: translate(-50%, -58%); width: min(380px, 86%); padding: 26px 20px; display: flex; flex-direction: column; align-items: center; gap: 16px; text-align: center; }
    .drop-panel h2 { font-size: 1.75rem; line-height: 1.1; font-weight: 600; font-stretch: 85%; letter-spacing: -0.01em; }
    .drop-panel .actions { display: flex; gap: 12px; flex-wrap: wrap; justify-content: center; }
    .drop-panel .hint { font-family: var(--mono); font-size: 0.75rem; color: var(--muted); letter-spacing: 0.04em; }
    .screen.dragover .drop-panel { box-shadow: 0 0 0 3px var(--lime), 0 12px 32px -8px rgba(10,12,10,0.35); }

    .check-panel { left: 20px; right: 20px; bottom: 20px; padding: 16px 18px; display: flex; justify-content: space-between; align-items: flex-end; gap: 16px; flex-wrap: wrap; }
    .checks { list-style: none; display: flex; flex-direction: column; gap: 8px; font-size: 0.875rem; }
    .checks li { display: flex; align-items: baseline; flex-wrap: wrap; column-gap: 8px; }
    .checks .dot { align-self: center; }
    .checks .dot { width: 14px; height: 14px; border-radius: 50%; flex-shrink: 0; display: inline-flex; align-items: center; justify-content: center; color: #fff; font-size: 10px; font-weight: 700; line-height: 1; }
    .checks .ok .dot { background: var(--ok); }
    .checks .warn .dot { background: var(--warn); }
    .checks .bad .dot { background: var(--bad); }
    .checks .tip .dot { background: #A9ADA8; }
    .checks small { color: var(--muted); font-size: 0.875rem; }
    .check-actions { display: flex; gap: 8px; }

    .tag { position: absolute; left: 92px; padding: 3px 8px; background: var(--lime); color: var(--screen); border-radius: var(--r-sm); font-family: var(--mono); font-size: 0.75rem; letter-spacing: 0.06em; text-transform: uppercase; }

    .scan-panel { left: 20px; right: 20px; bottom: 20px; padding: 16px 18px; }
    .steps { list-style: none; display: flex; gap: 16px; font-family: var(--mono); font-size: 0.75rem; letter-spacing: 0.06em; text-transform: uppercase; color: var(--muted); }
    .steps li[data-done="true"] { color: var(--ok); }
    .steps li[data-active="true"] { color: var(--ink); }
    .scan-notes { font-size: 0.8125rem; color: var(--ink-2); margin-bottom: 10px; display: flex; align-items: center; gap: 8px; }
    .scan-notes .dot { width: 14px; height: 14px; border-radius: 50%; background: var(--warn); color: #fff; font-size: 10px; font-weight: 700; display: inline-flex; align-items: center; justify-content: center; }
    .bar { margin-top: 12px; height: 3px; background: rgba(18,22,19,0.1); border-radius: var(--r-sm); overflow: hidden; }
    .bar i { display: block; height: 100%; width: 0; background: var(--ink); transition: width 600ms ease; }

    .chips-overlay { position: absolute; left: 20px; bottom: 20px; right: 96px; /* keep clear of the ticket overlap */ display: flex; flex-wrap: wrap; gap: 8px; }
    .chip { display: inline-flex; align-items: center; gap: 8px; padding: 5px 9px; background: rgba(255,255,255,0.92); color: var(--ink); border-radius: var(--r-sm); font-size: 0.8125rem; font-weight: 600; }
    .chip span { font-weight: 400; color: var(--muted); }

    .error-panel { left: 20px; right: 20px; bottom: 20px; padding: 16px 18px; display: flex; justify-content: space-between; align-items: center; gap: 16px; flex-wrap: wrap; }
    .error-panel p { font-size: 0.9375rem; }
    .error-panel strong { color: var(--bad); }

    .wall-panel { left: 50%; top: 50%; transform: translate(-50%, -50%); width: min(400px, 90%); padding: 20px; display: flex; flex-direction: column; gap: 12px; }
    .wall-panel h2 { font-size: 1.375rem; line-height: 1.15; font-weight: 600; font-stretch: 85%; }
    .wall-panel p { font-size: 0.9375rem; color: var(--ink-2); }
    .field { display: flex; flex-direction: column; gap: 4px; }
    .field label { font-size: 0.8125rem; font-weight: 600; }
    .field input { font: inherit; font-size: 1rem; padding: 10px 12px; border-radius: var(--r-md); border: 1px solid rgba(18,22,19,0.2); background: #fff; color: var(--ink); }
    .field input[aria-invalid="true"] { border-color: var(--bad); }
    .field .err { font-size: 0.8125rem; color: var(--bad); }
    .wall-panel .alt { font-size: 0.8125rem; color: var(--muted); }

    /* ── Ticket ───────────────────────────────────────── */
    .ticket, .ticket-slot { position: absolute; right: 0; top: 290px; width: 262px; transform: rotate(4deg); }
    .ticket-slot { height: 330px; border: 1.5px dashed rgba(18,22,19,0.25); border-radius: var(--r-sm); display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 4px; font-family: var(--mono); font-size: 0.6875rem; letter-spacing: 0.08em; color: var(--muted); z-index: 0; }
    .ticket {
      background: var(--paper); color: var(--ink); font-family: var(--mono); font-size: 0.6875rem; line-height: 1.4;
      box-shadow: 0 1px 2px rgba(18,22,19,0.08), 0 18px 36px -12px rgba(18,22,19,0.35);
      z-index: 2;
      background-image: radial-gradient(circle at 4px -1px, var(--ground) 4px, transparent 4.5px);
      background-size: 22px 8px; background-repeat: repeat-x; background-position: 4px 0;
      padding-top: 8px;
    }
    /* Printing: the ticket feeds out, then each line, total and stamp land in order. */
    .ticket { --rot: 4deg; }
    .ticket.printing { animation: feed 380ms cubic-bezier(0.16, 1, 0.3, 1) both; }
    @keyframes feed { from { opacity: 0; transform: rotate(var(--rot)) translateY(-18px); } }
    .ticket.printing [data-line] { animation: line-in 240ms cubic-bezier(0, 0, 0.2, 1) both; animation-delay: calc(320ms + var(--i) * 110ms); }
    @keyframes line-in { from { opacity: 0; transform: translateY(4px); } }
    .ticket.printing .stamp { animation: stamp 280ms cubic-bezier(0.34, 1.56, 0.64, 1) both; animation-delay: var(--stamp-delay, 900ms); }
    @keyframes stamp { from { opacity: 0; transform: rotate(-8deg) scale(1.35); } }
    .ticket-body { padding: 10px 18px 16px; display: flex; flex-direction: column; gap: 12px; }
    .t-head { display: flex; flex-direction: column; align-items: center; gap: 4px; padding-bottom: 8px; border-bottom: 1px dashed var(--ink); text-align: center; }
    .t-head strong { font-size: 0.8125rem; letter-spacing: 0.08em; }
    .t-head span { color: var(--muted); }
    .t-lines { list-style: none; display: flex; flex-direction: column; gap: 8px; }
    .t-lines li { display: flex; justify-content: space-between; gap: 8px; }
    .t-lines li > span:first-child { display: flex; align-items: center; gap: 8px; text-transform: uppercase; min-width: 0; }
    .t-lines .swatch { width: 7px; height: 7px; }
    .t-total { display: flex; justify-content: space-between; align-items: baseline; padding-top: 8px; border-top: 1px dashed var(--ink); }
    .t-total b { font-size: 1.375rem; line-height: 1.2; font-variant-numeric: tabular-nums; }
    .t-co2 { display: flex; justify-content: space-between; color: var(--muted); }
    .stamp { align-self: flex-end; padding: 3px 9px; border: 2px solid var(--ok); border-radius: var(--r-sm); transform: rotate(-8deg); font-weight: 700; letter-spacing: 0.14em; color: var(--ok); }
    .t-foot { display: block; text-align: center; padding: 10px 18px 14px; border-top: 1px dashed var(--ink); text-decoration: none; text-transform: uppercase; }
    .t-foot:hover { background: var(--lime); }
    .ticket-actions { margin-top: 16px; display: flex; gap: 8px; flex-wrap: wrap; }

    /* ── Materials & FAQ ──────────────────────────── */
    .section { border-top: 1px solid var(--line); padding: 96px 64px; max-width: 1440px; margin: 0 auto; width: 100%; }
    .split { display: grid; grid-template-columns: 420px 1fr; gap: 48px; align-items: start; }
    .split h2 { font-size: 3rem; line-height: 1; font-weight: 600; font-stretch: 85%; letter-spacing: -0.02em; margin: 12px 0 16px; text-wrap: balance; }
    .split .intro p { color: var(--ink-2); text-wrap: pretty; }
    .faq { list-style: none; border-top: 1px solid rgba(18,22,19,0.2); }
    .faq details { border-bottom: 1px solid var(--line); }
    .faq summary { list-style: none; cursor: pointer; display: flex; justify-content: space-between; align-items: center; gap: 16px; padding: 20px 0; font-size: 1.125rem; font-weight: 600; }
    .faq summary::-webkit-details-marker { display: none; }
    .faq summary::after { content: '+'; flex-shrink: 0; width: 24px; text-align: center; font-family: var(--mono); font-size: 1.25rem; font-weight: 400; color: var(--muted); }
    .faq details[open] summary::after { content: '−'; color: var(--ink); }
    .faq summary:focus-visible { outline: 2px solid var(--ink); outline-offset: 4px; }
    .faq details p { padding: 0 40px 20px 0; color: var(--ink-2); max-width: 680px; text-wrap: pretty; }
    /* ── How it works ─────────────────────────────── */
    html { scroll-behavior: smooth; }
    @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } }
    .how { border-top: 1px solid var(--line); padding: 96px 64px; max-width: 1440px; margin: 0 auto; width: 100%; scroll-margin-top: 0; }
    .how-head { display: flex; justify-content: space-between; align-items: flex-end; gap: 48px; margin-bottom: 48px; }
    .how-head h2 { font-size: 3rem; line-height: 1; font-weight: 600; font-stretch: 85%; letter-spacing: -0.02em; margin-top: 12px; text-wrap: balance; }
    .how-head p { max-width: 420px; color: var(--ink-2); text-wrap: pretty; }
    .steps-3 { list-style: none; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
    .step { background: var(--paper); border-radius: var(--r-lg); box-shadow: 0 0 0 1px rgba(18,22,19,0.08); padding: 20px; display: flex; flex-direction: column; gap: 16px; }
