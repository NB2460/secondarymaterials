    lineEls.forEach((n, i) => n.style.setProperty('--i', i));
    const totalDelay = 320 + (lineEls.length - 2) * 110;
    body.querySelector('.stamp').style.setProperty('--stamp-delay', (totalDelay + 700) + 'ms');
    ticket.append(body);
    ticket.append(el('a', { className: 't-foot', href: 'https://www.wastetide.ai', target: '_blank', rel: 'noopener', textContent: 'Get real offers → Wastetide' }));
    ticket.hidden = false;
    ticket.classList.remove('printing');
    if (!animate) return; // initial sample ticket: shown as-is
